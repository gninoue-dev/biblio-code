  "game/godot/joystick-tactile": {
    "scope": "gdscript",
    "prefix": "bib-joystick",
    "description": "Joystick virtuel tactile multi-touch (Godot 4)",
    "body": [
      "extends Control",
      "## Joystick virtuel tactile. Lire `direction` (Vector2, longueur 0 à 1) depuis le joueur.",
      "",
      "@export var rayon := 80.0",
      "@export var zone_morte := 0.15",
      "",
      "var direction := Vector2.ZERO",
      "var _doigt := -1",
      "var _position_bouton := Vector2.ZERO",
      "",
      "",
      "func _input(event: InputEvent) -> void:",
      "\tif event is InputEventScreenTouch:",
      "\t\tif event.pressed and _doigt == -1 and get_global_rect().has_point(event.position):",
      "\t\t\t_doigt = event.index",
      "\t\t\t_mettre_a_jour(event.position)",
      "\t\telif not event.pressed and event.index == _doigt:",
      "\t\t\t_doigt = -1",
      "\t\t\tdirection = Vector2.ZERO",
      "\t\t\t_position_bouton = Vector2.ZERO",
      "\t\t\tqueue_redraw()",
      "\telif event is InputEventScreenDrag and event.index == _doigt:",
      "\t\t_mettre_a_jour(event.position)",
      "",
      "",
      "func _mettre_a_jour(position_ecran: Vector2) -> void:",
      "\tvar ecart := (position_ecran - get_global_rect().get_center()).limit_length(rayon)",
      "\t_position_bouton = ecart",
      "\tvar d := ecart / rayon",
      "\tdirection = d if d.length() > zone_morte else Vector2.ZERO",
      "\tqueue_redraw()",
      "",
      "",
      "func _draw() -> void:",
      "\tvar centre := size / 2",
      "\tdraw_circle(centre, rayon, Color(1, 1, 1, 0.15))",
      "\tdraw_circle(centre + _position_bouton, rayon * 0.4, Color(1, 1, 1, 0.5))"
    ]
  },
  "game/godot/sauvegarde": {
    "scope": "gdscript",
    "prefix": "bib-save-godot",
    "description": "Autoload de sauvegarde JSON dans user:// (Godot 4)",
    "body": [
      "extends Node",
      "## Autoload : sauvegarde/chargement de la progression en JSON dans user://",
      "",
      "const CHEMIN := \"user://sauvegarde.json\"",
      "",
      "var donnees: Dictionary = {}",
      "",
      "",
      "func _ready() -> void:",
      "\tcharger()",
      "",
      "",
      "func sauvegarder() -> void:",
      "\tvar fichier := FileAccess.open(CHEMIN, FileAccess.WRITE)",
      "\tif fichier == null:",
      "\t\tpush_error(\"Sauvegarde impossible : %s\" % error_string(FileAccess.get_open_error()))",
      "\t\treturn",
      "\tfichier.store_string(JSON.stringify(donnees, \"\\\\t\"))",
      "",
      "",
      "func charger() -> void:",
      "\tif not FileAccess.file_exists(CHEMIN):",
      "\t\treturn",
      "\tvar resultat = JSON.parse_string(FileAccess.get_file_as_string(CHEMIN))",
      "\tif resultat is Dictionary:",
      "\t\tdonnees = resultat",
      "\telse:",
      "\t\tpush_warning(\"Sauvegarde illisible, ignorée.\")"
    ]
  },
  "game/godot/tremblement-camera": {
    "scope": "gdscript",
    "prefix": "bib-shake",
    "description": "Tremblement de caméra 2D sur les impacts (Godot 4)",
    "body": [
      "extends Camera2D",
      "## Tremblement de caméra : appeler secouer(force) lors d'un impact.",
      "",
      "@export var amortissement := 1.5",
      "@export var decalage_max := Vector2(12, 8)",
      "",
      "var _trauma := 0.0",
      "",
      "",
      "func secouer(force: float = 0.5) -> void:",
      "\t_trauma = minf(_trauma + force, 1.0)",
      "",
      "",
      "func _process(delta: float) -> void:",
      "\tif _trauma <= 0.0:",
      "\t\toffset = Vector2.ZERO",
      "\t\treturn",
      "\t_trauma = maxf(_trauma - amortissement * delta, 0.0)",
      "\tvar intensite := _trauma * _trauma",
      "\toffset = Vector2(",
      "\t\tdecalage_max.x * intensite * randf_range(-1.0, 1.0),",
      "\t\tdecalage_max.y * intensite * randf_range(-1.0, 1.0)",
      "\t)"
    ]
  },
  "game/unity/pool-objets": {
    "scope": "csharp",
    "prefix": "bib-pool",
    "description": "Pool d'objets pour projectiles/effets (évite les saccades)",
    "body": [
      "using UnityEngine;",
      "using UnityEngine.Pool;",
      "",
      "// Réutilise des objets (balles, effets, ennemis) au lieu de les créer/détruire sans cesse.",
      "public class PoolObjets : MonoBehaviour",
      "{",
      "    [SerializeField] private GameObject prefab;",
      "    [SerializeField] private int tailleInitiale = 20;",
      "    [SerializeField] private int tailleMax = 100;",
      "",
      "    private ObjectPool<GameObject> pool;",
      "",
      "    private void Awake()",
      "    {",
      "        pool = new ObjectPool<GameObject>(",
      "            createFunc: () => Instantiate(prefab, transform),",
      "            actionOnGet: obj => obj.SetActive(true),",
      "            actionOnRelease: obj => obj.SetActive(false),",
      "            actionOnDestroy: obj => Destroy(obj),",
      "            collectionCheck: false,",
      "            defaultCapacity: tailleInitiale,",
      "            maxSize: tailleMax);",
      "    }",
      "",
      "    public GameObject Prendre(Vector3 position, Quaternion rotation)",
      "    {",
      "        var obj = pool.Get();",
      "        obj.transform.SetPositionAndRotation(position, rotation);",
      "        return obj;",
      "    }",
      "",
      "    public void Rendre(GameObject obj) => pool.Release(obj);",
      "}"
    ]
  },
  "game/unity/sauvegarde-json": {
    "scope": "csharp",
    "prefix": "bib-save-unity",
    "description": "Sauvegarde/chargement JSON dans persistentDataPath",
    "body": [
      "using System.IO;",
      "using UnityEngine;",
      "",
      "// Sauvegarde n'importe quelle classe [System.Serializable] en JSON sur l'appareil.",
      "public static class SauvegardeJson",
      "{",
      "    private static string Chemin(string nom) =>",
      "        Path.Combine(Application.persistentDataPath, nom + \".json\");",
      "",
      "    public static void Sauvegarder<T>(T donnees, string nom = \"sauvegarde\")",
      "    {",
      "        File.WriteAllText(Chemin(nom), JsonUtility.ToJson(donnees, true));",
      "    }",
      "",
      "    public static T Charger<T>(string nom = \"sauvegarde\") where T : new()",
      "    {",
      "        var chemin = Chemin(nom);",
      "        if (!File.Exists(chemin)) return new T();",
      "        return JsonUtility.FromJson<T>(File.ReadAllText(chemin));",
      "    }",
      "}"
    ]
  },
  "game/unity/singleton": {
    "scope": "csharp",
    "prefix": "bib-singleton",
    "description": "Singleton générique pour managers (GameManager, AudioManager…)",
    "body": [
      "using UnityEngine;",
      "",
      "// Hérite de Singleton<MaClasse> pour avoir MaClasse.Instance accessible partout.",
      "public abstract class Singleton<T> : MonoBehaviour where T : MonoBehaviour",
      "{",
      "    public static T Instance { get; private set; }",
      "",
      "    [SerializeField] private bool persistantEntreScenes = true;",
      "",
      "    protected virtual void Awake()",
      "    {",
      "        if (Instance != null && Instance != this)",
      "        {",
      "            Destroy(gameObject);",
      "            return;",
      "        }",
      "        Instance = this as T;",
      "        if (persistantEntreScenes) DontDestroyOnLoad(gameObject);",
      "    }",
      "",
      "    protected virtual void OnDestroy()",
      "    {",
      "        if (Instance == this) Instance = null;",
      "    }",
      "}"
    ]
  },
  "mobile/android/connexion-reseau": {
    "scope": "kotlin",
    "prefix": "bib-reseau",
    "description": "Vérifie si le téléphone a vraiment Internet",
    "body": [
      "import android.content.Context",
      "import android.net.ConnectivityManager",
      "import android.net.NetworkCapabilities",
      "",
      "// Vrai si l'appareil a un accès Internet qui fonctionne réellement.",
      "fun Context.estConnecte(): Boolean {",
      "    val cm = getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager",
      "    val capacites = cm.getNetworkCapabilities(cm.activeNetwork) ?: return false",
      "    return capacites.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) &&",
      "        capacites.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED)",
      "}"
    ]
  },
  "mobile/android/permission-notifications": {
    "scope": "kotlin",
    "prefix": "bib-permnotif",
    "description": "Demande la permission d'envoyer des notifications (Android 13+)",
    "body": [
      "import android.Manifest",
      "import android.content.pm.PackageManager",
      "import android.os.Build",
      "import androidx.activity.ComponentActivity",
      "import androidx.activity.result.contract.ActivityResultContracts",
      "import androidx.core.content.ContextCompat",
      "",
      "class MainActivity : ComponentActivity() {",
      "    private val demandePermission =",
      "        registerForActivityResult(ActivityResultContracts.RequestPermission()) { accordee ->",
      "            if (!accordee) {",
      "                // Expliquer à l'utilisateur à quoi servent les notifications.",
      "            }",
      "        }",
      "",
      "    private fun demanderPermissionNotifications() {",
      "        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return",
      "        val dejaAccordee = ContextCompat.checkSelfPermission(",
      "            this, Manifest.permission.POST_NOTIFICATIONS",
      "        ) == PackageManager.PERMISSION_GRANTED",
      "        if (!dejaAccordee) demandePermission.launch(Manifest.permission.POST_NOTIFICATIONS)",
      "    }",
      "}"
    ]
  },
  "mobile/android/preferences": {
    "scope": "kotlin",
    "prefix": "bib-prefs",
    "description": "Sauvegarde de réglages simples avec SharedPreferences",
    "body": [
      "import android.content.Context",
      "import androidx.core.content.edit",
      "",
      "// Petites données persistantes (réglages, pseudo…) avec des propriétés typées.",
      "class Preferences(context: Context) {",
      "    private val prefs = context.getSharedPreferences(\"app_prefs\", Context.MODE_PRIVATE)",
      "",
      "    var premierLancement: Boolean",
      "        get() = prefs.getBoolean(\"premier_lancement\", true)",
      "        set(valeur) = prefs.edit { putBoolean(\"premier_lancement\", valeur) }",
      "",
      "    var pseudo: String?",
      "        get() = prefs.getString(\"pseudo\", null)",
      "        set(valeur) = prefs.edit { putString(\"pseudo\", valeur) }",
      "}"
    ]
  },
  "web/js/debounce": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-debounce",
    "description": "Retarde une fonction tant qu'elle est rappelée (recherche, resize…)",
    "body": [
      "// Retarde l'appel de `fn` jusqu'à ce que `delai` ms passent sans nouvel appel.",
      "export function debounce(fn, delai = 300) {",
      "  let minuteur;",
      "  return (...args) => {",
      "    clearTimeout(minuteur);",
      "    minuteur = setTimeout(() => fn(...args), delai);",
      "  };",
      "}"
    ]
  },
  "web/js/fetch-json": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-fetch",
    "description": "fetch JSON avec timeout et nouvelles tentatives automatiques",
    "body": [
      "// Requête JSON avec délai max et nouvelles tentatives (attente 0,5 s, 1 s, 2 s…).",
      "export async function fetchJson(url, { timeout = 8000, essais = 3, ...options } = {}) {",
      "  for (let essai = 1; essai <= essais; essai++) {",
      "    const controleur = new AbortController();",
      "    const minuteur = setTimeout(() => controleur.abort(), timeout);",
      "    try {",
      "      const reponse = await fetch(url, { ...options, signal: controleur.signal });",
      "      if (!reponse.ok) {",
      "        const erreur = new Error(`HTTP \\${reponse.status}`);",
      "        erreur.status = reponse.status;",
      "        throw erreur;",
      "      }",
      "      return await reponse.json();",
      "    } catch (erreur) {",
      "      const erreurClient = erreur.status >= 400 && erreur.status < 500;",
      "      if (essai === essais || erreurClient) throw erreur;",
      "      await new Promise((r) => setTimeout(r, 500 * 2 ** (essai - 1)));",
      "    } finally {",
      "      clearTimeout(minuteur);",
      "    }",
      "  }",
      "}"
    ]
  },
  "web/js/theme-sombre": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-theme",
    "description": "Bouton thème clair/sombre mémorisé dans le navigateur",
    "body": [
      "// Thème clair/sombre mémorisé ; par défaut, suit la préférence du système.",
      "const CLE = \"theme\";",
      "",
      "export function initTheme() {",
      "  const sauve = localStorage.getItem(CLE);",
      "  const systeme = matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\";",
      "  document.documentElement.dataset.theme = sauve ?? systeme;",
      "}",
      "",
      "export function basculerTheme() {",
      "  const nouveau = document.documentElement.dataset.theme === \"dark\" ? \"light\" : \"dark\";",
      "  document.documentElement.dataset.theme = nouveau;",
      "  localStorage.setItem(CLE, nouveau);",
      "  return nouveau;",
      "}"
    ]
  }
