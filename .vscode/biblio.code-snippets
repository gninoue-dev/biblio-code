  "web/utilitaires/recherche-floue": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-floue",
    "description": "Recherche tolérante aux fautes (« Vouliez-vous dire… »)",
    "body": [
      "// Recherche tolérante aux fautes de frappe : « Vouliez-vous dire… ? »",
      "const normaliser = (t) =>",
      "  String(t ?? \"\")",
      "    .normalize(\"NFD\")",
      "    .replace(/[̀-ͯ]/g, \"\")",
      "    .toLowerCase()",
      "    .trim();",
      "",
      "// Nombre minimal de lettres à ajouter, supprimer ou remplacer pour passer de a à b.",
      "export function distanceLevenshtein(a, b) {",
      "  let precedente = Array.from({ length: b.length + 1 }, (_, j) => j);",
      "  for (let i = 1; i <= a.length; i++) {",
      "    const courante = [i];",
      "    for (let j = 1; j <= b.length; j++) {",
      "      const cout = a[i - 1] === b[j - 1] ? 0 : 1;",
      "      courante[j] = Math.min(precedente[j] + 1, courante[j - 1] + 1, precedente[j - 1] + cout);",
      "    }",
      "    precedente = courante;",
      "  }",
      "  return precedente[b.length];",
      "}",
      "",
      "// 1 = identique, 0 = rien à voir (accents et majuscules ignorés)",
      "export function similarite(a, b) {",
      "  const x = normaliser(a);",
      "  const y = normaliser(b);",
      "  if (!x && !y) return 1;",
      "  return 1 - distanceLevenshtein(x, y) / Math.max(x.length, y.length);",
      "}",
      "",
      "// Meilleurs candidats pour une requête mal tapée.",
      "// `cle` : quel texte comparer quand les candidats sont des objets.",
      "export function suggestions(requete, candidats, { max = 3, similariteMin = 0.6, cle = (c) => c } = {}) {",
      "  const q = normaliser(requete);",
      "  if (!q) return [];",
      "  return candidats",
      "    .map((c) => {",
      "      const texte = normaliser(cle(c));",
      "      const mots = texte.split(/\\\\s+/);",
      "      const score = texte.includes(q) ? 1 : Math.max(similarite(q, texte), ...mots.map((m) => similarite(q, m)));",
      "      return { element: c, score };",
      "    })",
      "    .filter((r) => r.score >= similariteMin)",
      "    .sort((a, b) => b.score - a.score)",
      "    .slice(0, max);",
      "}"
    ]
  },
  "web/utilitaires/stockage": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-stockage",
    "description": "localStorage JSON avec expiration, sans erreurs",
    "body": [
      "// localStorage en JSON, avec expiration optionnelle et sans planter (navigation privée, quota plein).",
      "export const stockage = {",
      "  ecrire(cle, valeur, dureeMs) {",
      "    const entree = { valeur, expire: dureeMs ? Date.now() + dureeMs : null };",
      "    try {",
      "      localStorage.setItem(cle, JSON.stringify(entree));",
      "      return true;",
      "    } catch {",
      "      return false;",
      "    }",
      "  },",
      "",
      "  lire(cle, defaut = null) {",
      "    try {",
      "      const brut = localStorage.getItem(cle);",
      "      if (brut === null) return defaut;",
      "      const { valeur, expire } = JSON.parse(brut);",
      "      if (expire && Date.now() > expire) {",
      "        localStorage.removeItem(cle);",
      "        return defaut;",
      "      }",
      "      return valeur;",
      "    } catch {",
      "      return defaut;",
      "    }",
      "  },",
      "",
      "  supprimer(cle) {",
      "    try {",
      "      localStorage.removeItem(cle);",
      "    } catch {}",
      "  },",
      "};"
    ]
  },
  "web/utilitaires/telechargement": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-telecharger",
    "description": "Télécharger un fichier généré côté navigateur",
    "body": [
      "// Fait télécharger un fichier généré dans le navigateur (CSV, JSON, image…).",
      "export function telechargerFichier(contenu, nomFichier, type = \"text/plain;charset=utf-8\") {",
      "  const blob = contenu instanceof Blob ? contenu : new Blob([contenu], { type });",
      "  const url = URL.createObjectURL(blob);",
      "  const lien = Object.assign(document.createElement(\"a\"), { href: url, download: nomFichier });",
      "  document.body.append(lien);",
      "  lien.click();",
      "  lien.remove();",
      "  setTimeout(() => URL.revokeObjectURL(url), 1000);",
      "}"
    ]
  },
  "web/utilitaires/texte": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-texte",
    "description": "slug d'URL, troncature, échappement HTML anti-XSS",
    "body": [
      "// \"Été à Abidjan !\" → \"ete-a-abidjan\"",
      "export function slugifier(texte) {",
      "  return String(texte)",
      "    .normalize(\"NFD\")",
      "    .replace(/[̀-ͯ]/g, \"\")",
      "    .toLowerCase()",
      "    .replace(/[^a-z0-9]+/g, \"-\")",
      "    .replace(/^-+|-+\\$/g, \"\");",
      "}",
      "",
      "export function tronquer(texte, max = 100, suite = \"…\") {",
      "  return texte.length <= max ? texte : texte.slice(0, max - suite.length).trimEnd() + suite;",
      "}",
      "",
      "// À utiliser avant d'insérer du texte utilisateur dans du HTML (protection XSS).",
      "export function echapperHtml(texte) {",
      "  const entites = { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" };",
      "  return String(texte).replace(/[&<>\"']/g, (c) => entites[c]);",
      "}",
      "",
      "export function capitaliser(texte) {",
      "  return texte.charAt(0).toUpperCase() + texte.slice(1);",
      "}"
    ]
  },
  "web/utilitaires/theme-sombre": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-theme",
    "description": "Bouton thème clair/sombre mémorisé dans le navigateur",
    "body": [
      "// Thème clair/sombre mémorisé ; par défaut, suit la préférence du système.",
      "const CLE = \"theme\";",
      "",
      "export function initTheme() {",
      "  const sauve = localStorage.getItem(CLE);",
      "  const systeme = matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\";",
      "  document.documentElement.dataset.theme = sauve ?? systeme;",
      "}",
      "",
      "export function basculerTheme() {",
      "  const nouveau = document.documentElement.dataset.theme === \"dark\" ? \"light\" : \"dark\";",
      "  document.documentElement.dataset.theme = nouveau;",
      "  localStorage.setItem(CLE, nouveau);",
      "  return nouveau;",
      "}"
    ]
  },
  "web/utilitaires/throttle": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-throttle",
    "description": "Limite la fréquence d'appel d'une fonction (scroll, resize)",
    "body": [
      "// Exécute `fn` au plus une fois toutes les `intervalle` ms (scroll, mousemove, resize…).",
      "export function throttle(fn, intervalle = 200) {",
      "  let dernier = 0;",
      "  let minuteur;",
      "  return (...args) => {",
      "    const reste = intervalle - (Date.now() - dernier);",
      "    clearTimeout(minuteur);",
      "    if (reste <= 0) {",
      "      dernier = Date.now();",
      "      fn(...args);",
      "    } else {",
      "      minuteur = setTimeout(() => {",
      "        dernier = Date.now();",
      "        fn(...args);",
      "      }, reste);",
      "    }",
      "  };",
      "}"
    ]
  }
