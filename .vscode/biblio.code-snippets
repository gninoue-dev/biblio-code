  "python/config-env": {
    "scope": "python",
    "prefix": "bib-py-env",
    "description": "Lire un fichier .env et des variables typées (sans dépendance)",
    "body": [
      "\"\"\"Lit un fichier .env (clés API, jetons) sans dépendance, et convertit les valeurs en bons types.\"\"\"",
      "import os",
      "from pathlib import Path",
      "",
      "",
      "def charger_env(chemin=\".env\", ecraser=False):",
      "    \"\"\"Charge KEY=valeur dans os.environ. Gère les commentaires, les guillemets et « export ». Renvoie les clés lues.\"\"\"",
      "    fichier = Path(chemin)",
      "    if not fichier.exists():",
      "        return {}",
      "    lues = {}",
      "    for ligne in fichier.read_text(encoding=\"utf-8\").splitlines():",
      "        ligne = ligne.strip()",
      "        if not ligne or ligne.startswith(\"#\") or \"=\" not in ligne:",
      "            continue",
      "        cle, valeur = ligne.removeprefix(\"export \").split(\"=\", 1)",
      "        cle, valeur = cle.strip(), valeur.strip()",
      "        if len(valeur) >= 2 and valeur[0] == valeur[-1] and valeur[0] in \"\\\\\"'\":",
      "            valeur = valeur[1:-1]",
      "        elif \" #\" in valeur:",
      "            valeur = valeur.split(\" #\", 1)[0].rstrip()",
      "        lues[cle] = valeur",
      "        if ecraser or cle not in os.environ:",
      "            os.environ[cle] = valeur",
      "    return lues",
      "",
      "",
      "VRAI = {\"1\", \"true\", \"vrai\", \"oui\", \"yes\", \"on\"}",
      "FAUX = {\"0\", \"false\", \"faux\", \"non\", \"no\", \"off\", \"\"}",
      "",
      "",
      "def lire_env(nom, defaut=None, type_=str, obligatoire=False):",
      "    \"\"\"lire_env(\"RISQUE_PCT\", 1.0, float) ; lire_env(\"MODE_DEMO\", True, bool) ; lire_env(\"JETON\", obligatoire=True)\"\"\"",
      "    valeur = os.environ.get(nom)",
      "    if valeur is None:",
      "        if obligatoire:",
      "            raise RuntimeError(f\"Variable d'environnement manquante : {nom} (ajoute-la dans .env)\")",
      "        return defaut",
      "    if type_ is bool:",
      "        if valeur.strip().lower() in VRAI:",
      "            return True",
      "        if valeur.strip().lower() in FAUX:",
      "            return False",
      "        raise ValueError(f\"{nom} doit être vrai/faux, pas « {valeur} »\")",
      "    try:",
      "        return type_(valeur)",
      "    except ValueError as erreur:",
      "        raise ValueError(f\"{nom} : « {valeur} » n'est pas un {type_.__name__}\") from erreur"
    ]
  },
  "python/gestion-risque": {
    "scope": "python",
    "prefix": "bib-py-risque",
    "description": "Taille de position selon le risque (%), stop ATR, ratio risque/rendement",
    "body": [
      "\"\"\"Taille de position selon le risque accepté : la base de toute stratégie de trading qui dure.\"\"\"",
      "import math",
      "",
      "",
      "def taille_position(capital, risque_pct, entree, stop, valeur_par_point=1.0, pas=0.01, taille_min=0.0, taille_max=None):",
      "    \"\"\"",
      "    Taille telle que, si le stop est touché, la perte = risque_pct % du capital.",
      "    valeur_par_point : gain/perte pour un mouvement de 1,0 du prix avec une taille de 1",
      "                       (or XAUUSD : 1 lot = 100 onces → 100 \\$ par dollar de mouvement).",
      "    pas : arrondi inférieur imposé par le courtier (0,01 lot).",
      "    Renvoie 0 si la taille minimale ferait dépasser le risque.",
      "    \"\"\"",
      "    distance = abs(entree - stop)",
      "    if distance == 0 or capital <= 0 or risque_pct <= 0:",
      "        return 0.0",
      "    risque_argent = capital * risque_pct / 100",
      "    taille = risque_argent / (distance * valeur_par_point)",
      "    taille = math.floor(taille / pas + 1e-9) * pas",
      "    if taille_max is not None:",
      "        taille = min(taille, taille_max)",
      "    if taille < taille_min or taille <= 0:",
      "        return 0.0",
      "    decimales = max(0, -int(math.floor(math.log10(pas)))) if pas < 1 else 0",
      "    return round(taille, decimales)",
      "",
      "",
      "def perte_si_stop(taille, entree, stop, valeur_par_point=1.0):",
      "    return abs(entree - stop) * valeur_par_point * taille",
      "",
      "",
      "def ratio_risque_rendement(entree, stop, objectif):",
      "    \"\"\"2.0 = on vise à gagner deux fois ce qu'on risque.\"\"\"",
      "    risque = abs(entree - stop)",
      "    return abs(objectif - entree) / risque if risque else 0.0",
      "",
      "",
      "def stop_atr(entree, atr_valeur, multiple=1.5, achat=True):",
      "    \"\"\"Stop placé à `multiple` × ATR de l'entrée (s'adapte à la volatilité du marché).\"\"\"",
      "    return entree - multiple * atr_valeur if achat else entree + multiple * atr_valeur"
    ]
  },
  "python/indicateurs": {
    "scope": "python",
    "prefix": "bib-py-indicateurs",
    "description": "Indicateurs techniques : SMA, EMA, RSI, ATR, Bollinger, MACD (sans dépendance)",
    "body": [
      "\"\"\"Indicateurs techniques classiques, sans dépendance. Les listes renvoyées ont la même longueur",
      "que l'entrée : None tant qu'il n'y a pas assez de données (période de chauffe).\"\"\"",
      "",
      "",
      "def sma(valeurs, periode):",
      "    \"\"\"Moyenne mobile simple.\"\"\"",
      "    resultat, somme = [], 0.0",
      "    for i, v in enumerate(valeurs):",
      "        somme += v",
      "        if i >= periode:",
      "            somme -= valeurs[i - periode]",
      "        resultat.append(somme / periode if i >= periode - 1 else None)",
      "    return resultat",
      "",
      "",
      "def ema(valeurs, periode):",
      "    \"\"\"Moyenne mobile exponentielle (initialisée par la moyenne simple des `periode` premières valeurs).\"\"\"",
      "    resultat = [None] * len(valeurs)",
      "    if len(valeurs) < periode:",
      "        return resultat",
      "    alpha = 2 / (periode + 1)",
      "    courant = sum(valeurs[:periode]) / periode",
      "    resultat[periode - 1] = courant",
      "    for i in range(periode, len(valeurs)):",
      "        courant = alpha * valeurs[i] + (1 - alpha) * courant",
      "        resultat[i] = courant",
      "    return resultat",
      "",
      "",
      "def rsi(valeurs, periode=14):",
      "    \"\"\"RSI de Wilder (0 à 100). > 70 : suracheté, < 30 : survendu.\"\"\"",
      "    resultat = [None] * len(valeurs)",
      "    if len(valeurs) <= periode:",
      "        return resultat",
      "    variations = [valeurs[i] - valeurs[i - 1] for i in range(1, len(valeurs))]",
      "    gain = sum(max(v, 0) for v in variations[:periode]) / periode",
      "    perte = sum(max(-v, 0) for v in variations[:periode]) / periode",
      "",
      "    def valeur_rsi(g, p):",
      "        if p == 0:",
      "            return 100.0 if g > 0 else 50.0",
      "        return 100 - 100 / (1 + g / p)",
      "",
      "    resultat[periode] = valeur_rsi(gain, perte)",
      "    for i in range(periode, len(variations)):",
      "        gain = (gain * (periode - 1) + max(variations[i], 0)) / periode",
      "        perte = (perte * (periode - 1) + max(-variations[i], 0)) / periode",
      "        resultat[i + 1] = valeur_rsi(gain, perte)",
      "    return resultat",
      "",
      "",
      "def atr(hauts, bas, cloture, periode=14):",
      "    \"\"\"Average True Range de Wilder : volatilité moyenne, utile pour placer un stop.\"\"\"",
      "    vrais = []",
      "    for i in range(len(cloture)):",
      "        if i == 0:",
      "            vrais.append(hauts[0] - bas[0])",
      "        else:",
      "            vrais.append(max(hauts[i] - bas[i], abs(hauts[i] - cloture[i - 1]), abs(bas[i] - cloture[i - 1])))",
      "    resultat = [None] * len(cloture)",
      "    if len(cloture) < periode:",
      "        return resultat",
      "    courant = sum(vrais[:periode]) / periode",
      "    resultat[periode - 1] = courant",
      "    for i in range(periode, len(cloture)):",
      "        courant = (courant * (periode - 1) + vrais[i]) / periode",
      "        resultat[i] = courant",
      "    return resultat",
      "",
      "",
      "def bandes_bollinger(valeurs, periode=20, ecarts=2.0):",
      "    \"\"\"Renvoie (milieu, haut, bas). Écart-type de population, comme sur la plupart des plateformes.\"\"\"",
      "    milieu = sma(valeurs, periode)",
      "    haut, bas = [], []",
      "    for i, m in enumerate(milieu):",
      "        if m is None:",
      "            haut.append(None)",
      "            bas.append(None)",
      "            continue",
      "        fenetre = valeurs[i - periode + 1 : i + 1]",
      "        ecart_type = (sum((v - m) ** 2 for v in fenetre) / periode) ** 0.5",
      "        haut.append(m + ecarts * ecart_type)",
      "        bas.append(m - ecarts * ecart_type)",
      "    return milieu, haut, bas",
      "",
      "",
      "def macd(valeurs, rapide=12, lente=26, signal=9):",
      "    \"\"\"Renvoie (macd, signal, histogramme).\"\"\"",
      "    ema_rapide, ema_lente = ema(valeurs, rapide), ema(valeurs, lente)",
      "    ligne = [r - l if r is not None and l is not None else None for r, l in zip(ema_rapide, ema_lente)]",
      "    debut = next((i for i, v in enumerate(ligne) if v is not None), len(ligne))",
      "    ligne_signal = [None] * debut + ema(ligne[debut:], signal)",
      "    histogramme = [m - s if m is not None and s is not None else None for m, s in zip(ligne, ligne_signal)]",
      "    return ligne, ligne_signal, histogramme"
    ]
  },
  "python/journal": {
    "scope": "python",
    "prefix": "bib-py-journal",
    "description": "Logs console + fichier avec rotation automatique",
    "body": [
      "\"\"\"Journal (logs) prêt à l'emploi : console + fichier qui tourne (pas de fichier de 10 Go).\"\"\"",
      "import logging",
      "import sys",
      "from logging.handlers import RotatingFileHandler",
      "from pathlib import Path",
      "",
      "FORMAT = \"%(asctime)s | %(levelname)-7s | %(name)s | %(message)s\"",
      "",
      "",
      "def configurer_journal(nom=\"app\", fichier=None, niveau=logging.INFO, taille_max_mo=5, nombre_fichiers=5):",
      "    journal = logging.getLogger(nom)",
      "    journal.setLevel(niveau)",
      "    if journal.handlers:  # déjà configuré (évite les messages en double)",
      "        return journal",
      "    format_ = logging.Formatter(FORMAT, datefmt=\"%Y-%m-%d %H:%M:%S\")",
      "",
      "    console = logging.StreamHandler(sys.stdout)",
      "    console.setFormatter(format_)",
      "    journal.addHandler(console)",
      "",
      "    if fichier:",
      "        Path(fichier).parent.mkdir(parents=True, exist_ok=True)",
      "        rotation = RotatingFileHandler(fichier, maxBytes=taille_max_mo * 1024 * 1024, backupCount=nombre_fichiers, encoding=\"utf-8\")",
      "        rotation.setFormatter(format_)",
      "        journal.addHandler(rotation)",
      "    return journal"
    ]
  },
  "python/limiteur-debit": {
    "scope": "python",
    "prefix": "bib-py-limiteur",
    "description": "Limiteur de débit (N appels par période) pour respecter les quotas d'API",
    "body": [
      "\"\"\"Limite le nombre d'appels sur une période (respecter les quotas d'une API, éviter le bannissement).\"\"\"",
      "import threading",
      "import time",
      "from collections import deque",
      "",
      "",
      "class LimiteurDebit:",
      "    \"\"\"LimiteurDebit(10, 1.0) : au plus 10 appels par seconde (fenêtre glissante, compatible threads).\"\"\"",
      "",
      "    def __init__(self, appels, periode, horloge=time.monotonic, dormir=time.sleep):",
      "        self.appels = appels",
      "        self.periode = periode",
      "        self._horloge = horloge",
      "        self._dormir = dormir",
      "        self._instants = deque()",
      "        self._verrou = threading.Lock()",
      "",
      "    def acquerir(self):",
      "        \"\"\"Attend si nécessaire, puis réserve un appel. Renvoie le temps attendu (secondes).\"\"\"",
      "        attendu = 0.0",
      "        while True:",
      "            with self._verrou:",
      "                maintenant = self._horloge()",
      "                while self._instants and maintenant - self._instants[0] >= self.periode:",
      "                    self._instants.popleft()",
      "                if len(self._instants) < self.appels:",
      "                    self._instants.append(maintenant)",
      "                    return attendu",
      "                pause = self.periode - (maintenant - self._instants[0])",
      "            self._dormir(pause)",
      "            attendu += pause",
      "",
      "    def __enter__(self):",
      "        self.acquerir()",
      "        return self",
      "",
      "    def __exit__(self, *erreur):",
      "        return False"
    ]
  },
  "python/notification-telegram": {
    "scope": "python",
    "prefix": "bib-py-telegram",
    "description": "Alertes Telegram (bot, rapports) sans dépendance, messages longs découpés",
    "body": [
      "\"\"\"Envoie un message Telegram (alertes de bot, rapports) via l'API officielle, sans dépendance.\"\"\"",
      "import json",
      "import urllib.error",
      "import urllib.parse",
      "import urllib.request",
      "",
      "LIMITE = 4096  # caractères max par message Telegram",
      "",
      "",
      "def decouper(texte, limite=LIMITE):",
      "    \"\"\"Coupe un long texte en morceaux, de préférence à la fin d'une ligne.\"\"\"",
      "    morceaux = []",
      "    while len(texte) > limite:",
      "        coupure = texte.rfind(\"\\\\n\", 0, limite)",
      "        if coupure <= 0:",
      "            coupure = limite",
      "        morceaux.append(texte[:coupure])",
      "        texte = texte[coupure:].lstrip(\"\\\\n\")",
      "    if texte:",
      "        morceaux.append(texte)",
      "    return morceaux",
      "",
      "",
      "def envoyer_telegram(texte, jeton, chat_id, html=True, silencieux=False, delai=10):",
      "    \"\"\"Renvoie True si tout est parti. Ne lève pas d'exception : une alerte ne doit pas faire planter le bot.\"\"\"",
      "    url = f\"https://api.telegram.org/bot{jeton}/sendMessage\"",
      "    for morceau in decouper(texte):",
      "        donnees = {\"chat_id\": chat_id, \"text\": morceau, \"disable_notification\": silencieux}",
      "        if html:",
      "            donnees[\"parse_mode\"] = \"HTML\"",
      "        requete = urllib.request.Request(url, data=urllib.parse.urlencode(donnees).encode(), method=\"POST\")",
      "        try:",
      "            with urllib.request.urlopen(requete, timeout=delai) as reponse:",
      "                if not json.load(reponse).get(\"ok\"):",
      "                    return False",
      "        except (urllib.error.URLError, TimeoutError, ValueError):",
      "            return False",
      "    return True"
    ]
  },
  "python/reessayer": {
    "scope": "python",
    "prefix": "bib-py-reessayer",
    "description": "Décorateur de nouvelles tentatives avec attente exponentielle (sync et async)",
    "body": [
      "\"\"\"Décorateur : réessaie une fonction qui échoue (API instable, réseau), avec attente croissante.\"\"\"",
      "import asyncio",
      "import functools",
      "import logging",
      "import random",
      "import time",
      "",
      "journal = logging.getLogger(__name__)",
      "",
      "",
      "def reessayer(essais=3, attente=1.0, facteur=2.0, attente_max=30.0, exceptions=(Exception,), alea=True):",
      "    \"\"\"Attentes : 1 s, 2 s, 4 s… (+ un peu d'aléatoire pour ne pas frapper le serveur tous en même temps).\"\"\"",
      "",
      "    def calculer_attente(numero):",
      "        duree = min(attente * facteur ** (numero - 1), attente_max)",
      "        return duree * random.uniform(0.5, 1.0) if alea else duree",
      "",
      "    def decorateur(fonction):",
      "        if asyncio.iscoroutinefunction(fonction):",
      "            @functools.wraps(fonction)",
      "            async def enveloppe_async(*args, **kwargs):",
      "                for numero in range(1, essais + 1):",
      "                    try:",
      "                        return await fonction(*args, **kwargs)",
      "                    except exceptions as erreur:",
      "                        if numero == essais:",
      "                            raise",
      "                        duree = calculer_attente(numero)",
      "                        journal.warning(\"%s a échoué (%s), essai %d/%d dans %.1f s\", fonction.__name__, erreur, numero + 1, essais, duree)",
      "                        await asyncio.sleep(duree)",
      "            return enveloppe_async",
      "",
      "        @functools.wraps(fonction)",
      "        def enveloppe(*args, **kwargs):",
      "            for numero in range(1, essais + 1):",
      "                try:",
      "                    return fonction(*args, **kwargs)",
      "                except exceptions as erreur:",
      "                    if numero == essais:",
      "                        raise",
      "                    duree = calculer_attente(numero)",
      "                    journal.warning(\"%s a échoué (%s), essai %d/%d dans %.1f s\", fonction.__name__, erreur, numero + 1, essais, duree)",
      "                    time.sleep(duree)",
      "        return enveloppe",
      "",
      "    return decorateur"
    ]
  },
  "web/app/cache-requetes": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-cache",
    "description": "Cache d'appels API (durée de vie, dédoublonnage, rafraîchissement en fond)",
    "body": [
      "// Met en cache le résultat d'une fonction asynchrone (appel d'API) pendant `dureeMs`.",
      "// - Deux appels simultanés avec les mêmes arguments ne déclenchent qu'une seule requête.",
      "// - `perime: true` : renvoie tout de suite l'ancienne valeur et la rafraîchit en arrière-plan.",
      "export function memoriserAsync(fn, { dureeMs = 60_000, perime = false, cle = (...args) => JSON.stringify(args) } = {}) {",
      "  const cache = new Map(); // cle → { valeur, expire, aValeur, promesse }",
      "",
      "  function rafraichir(k, args) {",
      "    const entree = cache.get(k) ?? {};",
      "    entree.promesse = Promise.resolve()",
      "      .then(() => fn(...args))",
      "      .then(",
      "        (valeur) => {",
      "          cache.set(k, { valeur, aValeur: true, expire: Date.now() + dureeMs });",
      "          return valeur;",
      "        },",
      "        (erreur) => {",
      "          if (entree.aValeur) delete entree.promesse;",
      "          else cache.delete(k);",
      "          throw erreur;",
      "        }",
      "      );",
      "    cache.set(k, entree);",
      "    return entree.promesse;",
      "  }",
      "",
      "  const memorisee = (...args) => {",
      "    const k = cle(...args);",
      "    const entree = cache.get(k);",
      "    if (entree?.aValeur && entree.expire > Date.now()) return Promise.resolve(entree.valeur);",
      "    if (entree?.promesse) return entree.aValeur && perime ? Promise.resolve(entree.valeur) : entree.promesse;",
      "    if (entree?.aValeur && perime) {",
      "      rafraichir(k, args).catch(() => {});",
      "      return Promise.resolve(entree.valeur);",
      "    }",
      "    return rafraichir(k, args);",
      "  };",
      "",
      "  memorisee.invalider = (...args) => (args.length ? cache.delete(cle(...args)) : cache.clear());",
      "  return memorisee;",
      "}"
    ]
  },
  "web/app/client-api": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-api",
    "description": "Client API REST avec jeton et renouvellement automatique",
    "body": [
      "// Client HTTP pour API REST : JSON automatique, jeton Bearer, renouvellement du jeton sur 401.",
      "export function creerClientApi({ baseUrl = \"\", lireJeton, rafraichirJeton, surDeconnexion } = {}) {",
      "  let rafraichissement = null; // un seul renouvellement à la fois, même si 10 requêtes échouent",
      "",
      "  async function requete(chemin, { methode = \"GET\", corps, entetes = {} } = {}, dejaReessaye = false) {",
      "    const jeton = lireJeton?.();",
      "    const reponse = await fetch(baseUrl + chemin, {",
      "      method: methode,",
      "      credentials: \"include\",",
      "      headers: {",
      "        ...(corps !== undefined && { \"Content-Type\": \"application/json\" }),",
      "        ...(jeton && { Authorization: `Bearer \\${jeton}` }),",
      "        ...entetes,",
      "      },",
      "      body: corps !== undefined ? JSON.stringify(corps) : undefined,",
      "    });",
      "",
      "    if (reponse.status === 401 && rafraichirJeton && !dejaReessaye) {",
      "      rafraichissement ??= rafraichirJeton().finally(() => (rafraichissement = null));",
      "      const ok = await rafraichissement.catch(() => false);",
      "      if (ok) return requete(chemin, { methode, corps, entetes }, true);",
      "      surDeconnexion?.();",
      "    }",
      "",
      "    if (!reponse.ok) {",
      "      const erreur = new Error(`HTTP \\${reponse.status}`);",
      "      erreur.status = reponse.status;",
      "      erreur.donnees = await reponse.json().catch(() => null);",
      "      throw erreur;",
      "    }",
      "    return reponse.status === 204 ? null : reponse.json();",
      "  }",
      "",
      "  return {",
      "    get: (chemin, options) => requete(chemin, { ...options, methode: \"GET\" }),",
      "    post: (chemin, corps, options) => requete(chemin, { ...options, methode: \"POST\", corps }),",
      "    put: (chemin, corps, options) => requete(chemin, { ...options, methode: \"PUT\", corps }),",
      "    patch: (chemin, corps, options) => requete(chemin, { ...options, methode: \"PATCH\", corps }),",
      "    delete: (chemin, options) => requete(chemin, { ...options, methode: \"DELETE\" }),",
      "  };",
      "}"
    ]
  },
  "web/app/compression-image": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-compresser",
    "description": "Compression/redimensionnement d'image avant envoi (photos téléphone)",
    "body": [
      "// Réduit une photo avant envoi (une photo de téléphone de 5 Mo passe souvent à environ 300 Ko).",
      "// Respecte l'orientation EXIF. Renvoie le fichier d'origine si la compression ne gagne rien.",
      "export async function compresserImage(fichier, { largeurMax = 1600, hauteurMax = 1600, qualite = 0.8, type = \"image/jpeg\" } = {}) {",
      "  const image = await createImageBitmap(fichier, { imageOrientation: \"from-image\" });",
      "  const echelle = Math.min(1, largeurMax / image.width, hauteurMax / image.height);",
      "  const canvas = document.createElement(\"canvas\");",
      "  canvas.width = Math.round(image.width * echelle);",
      "  canvas.height = Math.round(image.height * echelle);",
      "  const ctx = canvas.getContext(\"2d\");",
      "  if (type === \"image/jpeg\") {",
      "    ctx.fillStyle = \"#fff\"; // le JPEG n'a pas de transparence",
      "    ctx.fillRect(0, 0, canvas.width, canvas.height);",
      "  }",
      "  ctx.drawImage(image, 0, 0, canvas.width, canvas.height);",
      "  image.close();",
      "",
      "  const blob = await new Promise((resoudre) => canvas.toBlob(resoudre, type, qualite));",
      "  if (!blob || (blob.size >= fichier.size && echelle === 1)) return fichier;",
      "  const extension = { \"image/jpeg\": \".jpg\", \"image/webp\": \".webp\", \"image/png\": \".png\" }[type] ?? \"\";",
      "  return new File([blob], fichier.name.replace(/\\\\.[^.]+\\$/, \"\") + extension, { type });",
      "}"
    ]
  },
  "web/app/defilement-infini": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-scroll-infini",
    "description": "Défilement infini avec IntersectionObserver",
    "body": [
      "// Charge la suite d'une liste quand l'élément « sentinelle » (en bas) devient visible.",
      "// `chargerSuite` renvoie false quand il n'y a plus rien à charger.",
      "// `racine` : le conteneur qui défile, si la liste est dans une boîte (null = la page entière).",
      "export function defilementInfini(sentinelle, chargerSuite, { marge = \"300px\", racine = null } = {}) {",
      "  let enCours = false;",
      "  const observateur = new IntersectionObserver(",
      "    async ([entree]) => {",
      "      if (!entree.isIntersecting || enCours) return;",
      "      enCours = true;",
      "      try {",
      "        const encore = await chargerSuite();",
      "        if (encore === false) return observateur.disconnect();",
      "        // Ré-observer : si la sentinelle est toujours visible, on recharge encore.",
      "        observateur.unobserve(sentinelle);",
      "        observateur.observe(sentinelle);",
      "      } finally {",
      "        enCours = false;",
      "      }",
      "    },",
      "    { root: racine, rootMargin: marge }",
      "  );",
      "  observateur.observe(sentinelle);",
      "  return () => observateur.disconnect();",
      "}"
    ]
  },
  "web/app/formulaire-etapes": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-etapes",
    "description": "Formulaire en plusieurs étapes avec validation et progression",
    "body": [
      "// Parcours en plusieurs étapes (ouverture de compte, commande, inscription…).",
      "// etapes : [{ id, valider?: (donnees) => ({ champ: \"message\" }) | null }]",
      "export function creerParcours(etapes, donneesInitiales = {}) {",
      "  let index = 0;",
      "  let donnees = { ...donneesInitiales };",
      "  const validee = new Set();",
      "",
      "  const valider = (i) => {",
      "    const erreurs = etapes[i].valider?.(donnees) ?? null;",
      "    return erreurs && Object.keys(erreurs).length ? erreurs : null;",
      "  };",
      "",
      "  return {",
      "    get etape() { return etapes[index]; },",
      "    get index() { return index; },",
      "    get donnees() { return donnees; },",
      "    get progression() { return etapes.length > 1 ? index / (etapes.length - 1) : 1; },",
      "    get estPremiere() { return index === 0; },",
      "    get estDerniere() { return index === etapes.length - 1; },",
      "",
      "    modifier(maj) {",
      "      donnees = { ...donnees, ...maj };",
      "    },",
      "    // Valide l'étape en cours puis avance. Renvoie { ok, erreurs }.",
      "    suivant() {",
      "      const erreurs = valider(index);",
      "      if (erreurs) return { ok: false, erreurs };",
      "      validee.add(index);",
      "      if (index < etapes.length - 1) index++;",
      "      return { ok: true, erreurs: null };",
      "    },",
      "    precedent() {",
      "      if (index > 0) index--;",
      "    },",
      "    // On ne peut sauter qu'à une étape déjà atteinte (pas de triche sur la validation).",
      "    allerA(id) {",
      "      const cible = etapes.findIndex((e) => e.id === id);",
      "      if (cible === -1 || (cible > index && ![...Array(cible).keys()].every((i) => validee.has(i)))) return false;",
      "      index = cible;",
      "      return true;",
      "    },",
      "    // Revalide tout avant l'envoi final",
      "    terminer() {",
      "      for (let i = 0; i < etapes.length; i++) {",
      "        const erreurs = valider(i);",
      "        if (erreurs) {",
      "          index = i;",
      "          return { ok: false, erreurs, etape: etapes[i].id };",
      "        }",
      "      }",
      "      return { ok: true, donnees };",
      "    },",
      "  };",
      "}"
    ]
  },
  "web/app/graphiques": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-graphique",
    "description": "Graphiques SVG sans bibliothèque (sparkline, barres)",
    "body": [
      "// Petits graphiques SVG sans bibliothèque. Les fonctions renvoient du code SVG (texte).",
      "const echapper = (t) => String(t).replace(/[&<>\"]/g, (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" })[c]);",
      "const arrondi = (n) => Math.round(n * 10) / 10;",
      "",
      "// Mini courbe d'évolution (solde, cours de l'or…)",
      "export function sparkline(valeurs, { largeur = 120, hauteur = 32, couleur = \"currentColor\", epaisseur = 2 } = {}) {",
      "  if (valeurs.length < 2) return `<svg width=\"\\${largeur}\" height=\"\\${hauteur}\"></svg>`;",
      "  const min = Math.min(...valeurs);",
      "  const etendue = Math.max(...valeurs) - min || 1;",
      "  const m = epaisseur;",
      "  const points = valeurs",
      "    .map((v, i) => {",
      "      const x = m + (i / (valeurs.length - 1)) * (largeur - 2 * m);",
      "      const y = m + (1 - (v - min) / etendue) * (hauteur - 2 * m);",
      "      return `\\${arrondi(x)},\\${arrondi(y)}`;",
      "    })",
      "    .join(\" \");",
      "  return `<svg width=\"\\${largeur}\" height=\"\\${hauteur}\" viewBox=\"0 0 \\${largeur} \\${hauteur}\" role=\"img\" aria-label=\"Évolution de \\${valeurs[0]} à \\${valeurs.at(-1)}\"><polyline points=\"\\${points}\" fill=\"none\" stroke=\"\\${couleur}\" stroke-width=\"\\${epaisseur}\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/></svg>`;",
      "}",
      "",
      "// Histogramme horizontal : [{ libelle, valeur }] (dépenses par catégorie…)",
      "export function barres(donnees, { largeur = 320, hauteurBarre = 22, ecart = 8, couleur = \"currentColor\", formater = String } = {}) {",
      "  const max = Math.max(...donnees.map((d) => d.valeur), 0) || 1;",
      "  const colonneLibelle = 100;",
      "  const colonneValeur = 70;",
      "  const zone = largeur - colonneLibelle - colonneValeur;",
      "  const hauteur = donnees.length * (hauteurBarre + ecart);",
      "  const lignes = donnees",
      "    .map((d, i) => {",
      "      const y = i * (hauteurBarre + ecart);",
      "      const l = Math.max(0, (d.valeur / max) * zone);",
      "      const milieu = y + hauteurBarre / 2;",
      "      return `<g><title>\\${echapper(d.libelle)} : \\${echapper(formater(d.valeur))}</title>` +",
      "        `<text x=\"\\${colonneLibelle - 8}\" y=\"\\${milieu}\" text-anchor=\"end\" dominant-baseline=\"middle\" font-size=\"12\" fill=\"currentColor\">\\${echapper(d.libelle)}</text>` +",
      "        `<rect x=\"\\${colonneLibelle}\" y=\"\\${y}\" width=\"\\${arrondi(l)}\" height=\"\\${hauteurBarre}\" rx=\"4\" fill=\"\\${couleur}\"/>` +",
      "        `<text x=\"\\${arrondi(colonneLibelle + l + 6)}\" y=\"\\${milieu}\" dominant-baseline=\"middle\" font-size=\"12\" fill=\"currentColor\">\\${echapper(formater(d.valeur))}</text></g>`;",
      "    })",
      "    .join(\"\");",
      "  return `<svg width=\"100%\" viewBox=\"0 0 \\${largeur} \\${hauteur}\" role=\"img\">\\${lignes}</svg>`;",
      "}"
    ]
  },
  "web/app/hors-ligne": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-hors-ligne",
    "description": "File d'attente hors ligne : actions envoyées au retour du réseau",
    "body": [
      "// File d'attente hors ligne : les actions faites sans réseau sont gardées et envoyées au retour de la connexion.",
      "// `envoyer(donnees)` doit lancer une erreur si l'envoi échoue. Une erreur avec `definitive: true`",
      "// (ex. 400 refusé par le serveur) retire l'action de la file au lieu de la réessayer.",
      "export function creerFileHorsLigne({ envoyer, cle = \"file-hors-ligne\", stockage = globalThis.localStorage, surChangement } = {}) {",
      "  const lire = () => {",
      "    try {",
      "      return JSON.parse(stockage?.getItem(cle) ?? \"[]\");",
      "    } catch {",
      "      return [];",
      "    }",
      "  };",
      "  let file = lire();",
      "  let envoiEnCours = null;",
      "",
      "  const enregistrer = () => {",
      "    try {",
      "      stockage?.setItem(cle, JSON.stringify(file));",
      "    } catch {}",
      "    surChangement?.(file.length);",
      "  };",
      "",
      "  async function vider() {",
      "    if (globalThis.navigator?.onLine === false) return;",
      "    envoiEnCours ??= (async () => {",
      "      while (file.length) {",
      "        try {",
      "          await envoyer(file[0].donnees);",
      "        } catch (erreur) {",
      "          if (!erreur?.definitive) break; // réseau toujours absent : on réessaiera plus tard",
      "        }",
      "        file.shift();",
      "        enregistrer();",
      "      }",
      "    })().finally(() => (envoiEnCours = null));",
      "    return envoiEnCours;",
      "  }",
      "",
      "  function ajouter(donnees) {",
      "    file.push({ id: crypto.randomUUID(), date: new Date().toISOString(), donnees });",
      "    enregistrer();",
      "    return vider();",
      "  }",
      "",
      "  globalThis.addEventListener?.(\"online\", vider);",
      "  return { ajouter, vider, enAttente: () => file.length, elements: () => file.map((e) => e.donnees) };",
      "}"
    ]
  },
  "web/app/i18n": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-i18n",
    "description": "Traductions multilingues avec variables",
    "body": [
      "// Traductions avec variables : t(\"bonjour\", { nom: \"Awa\" }) → \"Bonjour Awa\".",
      "export function creerI18n(dictionnaires, langueParDefaut = \"fr\") {",
      "  let langue = langueParDefaut;",
      "  return {",
      "    t(cle, variables = {}) {",
      "      const texte = dictionnaires[langue]?.[cle] ?? dictionnaires[langueParDefaut]?.[cle] ?? cle;",
      "      return texte.replace(/\\\\{(\\\\w+)\\\\}/g, (_, nom) => variables[nom] ?? `{\\${nom}}`);",
      "    },",
      "    changerLangue(nouvelle) {",
      "      if (dictionnaires[nouvelle]) langue = nouvelle;",
      "    },",
      "    get langue() {",
      "      return langue;",
      "    },",
      "  };",
      "}"
    ]
  },
  "web/app/modale": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-confirmer",
    "description": "Boîte de confirmation accessible (élément dialog, await)",
    "body": [
      "// Fenêtre de confirmation basée sur <dialog> : focus géré, Échap ferme, accessible.",
      "// Renvoie une promesse : true si l'utilisateur confirme.",
      "export function confirmer(message, { titre = \"Confirmation\", ok = \"Confirmer\", annuler = \"Annuler\" } = {}) {",
      "  return new Promise((resoudre) => {",
      "    const dialog = document.createElement(\"dialog\");",
      "    dialog.innerHTML = `",
      "      <form method=\"dialog\">",
      "        <h2 style=\"margin-top:0\"></h2>",
      "        <p></p>",
      "        <div style=\"display:flex;gap:8px;justify-content:flex-end\">",
      "          <button value=\"non\"></button>",
      "          <button value=\"oui\" autofocus></button>",
      "        </div>",
      "      </form>`;",
      "    // textContent : aucun risque d'injection HTML via le message.",
      "    dialog.querySelector(\"h2\").textContent = titre;",
      "    dialog.querySelector(\"p\").textContent = message;",
      "    dialog.querySelector('[value=\"non\"]').textContent = annuler;",
      "    dialog.querySelector('[value=\"oui\"]').textContent = ok;",
      "",
      "    dialog.addEventListener(\"close\", () => {",
      "      resoudre(dialog.returnValue === \"oui\");",
      "      dialog.remove();",
      "    });",
      "    document.body.append(dialog);",
      "    dialog.showModal();",
      "  });",
      "}"
    ]
  },
  "web/app/pagination": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-pagination",
    "description": "Pagination d'une liste + numéros de pages avec « … »",
    "body": [
      "// Découpe une liste en pages.",
      "export function paginer(elements, page = 1, parPage = 10) {",
      "  const totalPages = Math.max(1, Math.ceil(elements.length / parPage));",
      "  const courante = Math.min(Math.max(1, page), totalPages);",
      "  const debut = (courante - 1) * parPage;",
      "  return {",
      "    elements: elements.slice(debut, debut + parPage),",
      "    page: courante,",
      "    totalPages,",
      "    total: elements.length,",
      "    precedente: courante > 1 ? courante - 1 : null,",
      "    suivante: courante < totalPages ? courante + 1 : null,",
      "  };",
      "}",
      "",
      "// Numéros de page à afficher : numerosPages(5, 20) → [1, \"…\", 4, 5, 6, \"…\", 20]",
      "export function numerosPages(page, totalPages, voisins = 1) {",
      "  const pages = [];",
      "  for (let p = 1; p <= totalPages; p++) {",
      "    if (p === 1 || p === totalPages || Math.abs(p - page) <= voisins) pages.push(p);",
      "    else if (pages.at(-1) !== \"…\") pages.push(\"…\");",
      "  }",
      "  return pages;",
      "}"
    ]
  },
  "web/app/panier": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-panier",
    "description": "Panier e-commerce : quantités, code promo, livraison offerte, TVA",
    "body": [
      "// Panier e-commerce. Prix en unités mineures (centimes, ou francs CFA), prix TTC.",
      "// Les fonctions ne modifient jamais le panier reçu : elles en renvoient un nouveau.",
      "",
      "export function ajouterAuPanier(lignes, produit, quantite = 1) {",
      "  const existe = lignes.some((l) => l.id === produit.id);",
      "  if (!existe) return [...lignes, { ...produit, quantite }];",
      "  return lignes.map((l) => (l.id === produit.id ? { ...l, quantite: l.quantite + quantite } : l));",
      "}",
      "",
      "export function modifierQuantite(lignes, id, quantite) {",
      "  return quantite <= 0",
      "    ? lignes.filter((l) => l.id !== id)",
      "    : lignes.map((l) => (l.id === id ? { ...l, quantite } : l));",
      "}",
      "",
      "export function retirerDuPanier(lignes, id) {",
      "  return lignes.filter((l) => l.id !== id);",
      "}",
      "",
      "// remise : { type: \"pourcentage\" | \"montant\", valeur, minimum? }",
      "// livraison : frais fixes ; livraisonGratuiteDes : seuil de gratuité ; tauxTva : TVA incluse dans les prix",
      "export function calculerPanier(lignes, { remise, livraison = 0, livraisonGratuiteDes, tauxTva = 0 } = {}) {",
      "  const sousTotal = lignes.reduce((s, l) => s + l.prix * l.quantite, 0);",
      "  const nombreArticles = lignes.reduce((s, l) => s + l.quantite, 0);",
      "",
      "  let montantRemise = 0;",
      "  let erreurRemise = null;",
      "  if (remise) {",
      "    if (remise.minimum && sousTotal < remise.minimum) erreurRemise = \"minimum\";",
      "    else if (remise.type === \"pourcentage\") montantRemise = Math.round((sousTotal * remise.valeur) / 100);",
      "    else montantRemise = Math.min(remise.valeur, sousTotal);",
      "  }",
      "",
      "  const apresRemise = sousTotal - montantRemise;",
      "  const fraisLivraison =",
      "    nombreArticles === 0 || (livraisonGratuiteDes !== undefined && apresRemise >= livraisonGratuiteDes) ? 0 : livraison;",
      "  const total = apresRemise + fraisLivraison;",
      "  const dontTva = tauxTva ? total - Math.round(total / (1 + tauxTva / 100)) : 0;",
      "",
      "  return {",
      "    nombreArticles,",
      "    sousTotal,",
      "    remise: montantRemise,",
      "    erreurRemise,",
      "    livraison: fraisLivraison,",
      "    total,",
      "    dontTva,",
      "    manquePourLivraisonGratuite:",
      "      livraisonGratuiteDes !== undefined ? Math.max(0, livraisonGratuiteDes - apresRemise) : null,",
      "  };",
      "}"
    ]
  },
  "web/app/partage": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-partage",
    "description": "Partage natif + liens WhatsApp, Telegram, SMS, email",
    "body": [
      "// Partage natif du téléphone, avec repli sur la copie. Liens directs WhatsApp, Telegram, SMS, email.",
      "",
      "// Renvoie \"partage\", \"copie\" ou \"annule\"",
      "export async function partager({ titre, texte, url }) {",
      "  if (navigator.share) {",
      "    try {",
      "      await navigator.share({ title: titre, text: texte, url });",
      "      return \"partage\";",
      "    } catch (erreur) {",
      "      if (erreur.name === \"AbortError\") return \"annule\";",
      "    }",
      "  }",
      "  await navigator.clipboard.writeText([texte, url].filter(Boolean).join(\" \"));",
      "  return \"copie\";",
      "}",
      "",
      "const chiffres = (numero) => String(numero ?? \"\").replace(/\\\\D/g, \"\");",
      "",
      "// numero au format international sans + : \"2250707123456\". Sans numéro : l'utilisateur choisit le contact.",
      "export function lienWhatsApp(texte, numero) {",
      "  return `https://wa.me/\\${chiffres(numero)}?text=\\${encodeURIComponent(texte)}`;",
      "}",
      "",
      "export function lienTelegram(url, texte = \"\") {",
      "  return `https://t.me/share/url?url=\\${encodeURIComponent(url)}&text=\\${encodeURIComponent(texte)}`;",
      "}",
      "",
      "export function lienSms(numero, texte) {",
      "  return `sms:\\${String(numero).replace(/[^\\\\d+]/g, \"\")}?body=\\${encodeURIComponent(texte)}`;",
      "}",
      "",
      "export function lienEmail(destinataire, { sujet = \"\", corps = \"\" } = {}) {",
      "  const params = new URLSearchParams({ subject: sujet, body: corps }).toString().replace(/\\\\+/g, \"%20\");",
      "  return `mailto:\\${destinataire}?\\${params}`;",
      "}"
    ]
  },
  "web/app/pwa": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-pwa",
    "description": "Appli installable (PWA) : service worker, bouton installer, état réseau",
    "body": [
      "// Application web installable (PWA) : service worker, bouton « Installer l'appli », état du réseau.",
      "",
      "export async function enregistrerServiceWorker(chemin = \"/sw.js\") {",
      "  if (!(\"serviceWorker\" in navigator)) return null;",
      "  try {",
      "    return await navigator.serviceWorker.register(chemin);",
      "  } catch (erreur) {",
      "    console.warn(\"Service worker non enregistré :\", erreur);",
      "    return null;",
      "  }",
      "}",
      "",
      "// Affiche `bouton` quand le navigateur propose l'installation (Android/Chrome/Edge).",
      "export function boutonInstallation(bouton, { surInstallation } = {}) {",
      "  let invite = null;",
      "  bouton.hidden = true;",
      "  addEventListener(\"beforeinstallprompt\", (e) => {",
      "    e.preventDefault();",
      "    invite = e;",
      "    bouton.hidden = false;",
      "  });",
      "  bouton.addEventListener(\"click\", async () => {",
      "    if (!invite) return;",
      "    invite.prompt();",
      "    await invite.userChoice;",
      "    invite = null;",
      "    bouton.hidden = true;",
      "  });",
      "  addEventListener(\"appinstalled\", () => {",
      "    bouton.hidden = true;",
      "    surInstallation?.();",
      "  });",
      "}",
      "",
      "// rappel(true|false) à chaque changement de connexion. Renvoie une fonction pour arrêter.",
      "export function surveillerConnexion(rappel) {",
      "  const maj = () => rappel(navigator.onLine);",
      "  addEventListener(\"online\", maj);",
      "  addEventListener(\"offline\", maj);",
      "  maj();",
      "  return () => {",
      "    removeEventListener(\"online\", maj);",
      "    removeEventListener(\"offline\", maj);",
      "  };",
      "}",
      "",
      "export const estAppInstallee = () =>",
      "  matchMedia(\"(display-mode: standalone)\").matches || navigator.standalone === true;"
    ]
  },
  "web/app/routeur": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-routeur",
    "description": "Routeur SPA par hash avec paramètres (#/comptes/:id)",
    "body": [
      "// Mini routeur pour application monopage (SPA) basé sur le hash : \"#/comptes/:id\".",
      "",
      "// Teste un chemin contre un motif et renvoie les paramètres, ou null.",
      "export function correspondreRoute(motif, chemin) {",
      "  const noms = [];",
      "  const source = motif",
      "    .replace(/[.*+?^\\${}()|[\\\\]\\\\\\\\]/g, \"\\\\\\\\\\$&\")",
      "    .replace(/:(\\\\w+)/g, (_, nom) => {",
      "      noms.push(nom);",
      "      return \"([^/]+)\";",
      "    });",
      "  const m = chemin.match(new RegExp(`^\\${source}/?\\$`));",
      "  if (!m) return null;",
      "  return Object.fromEntries(noms.map((n, i) => [n, decodeURIComponent(m[i + 1])]));",
      "}",
      "",
      "export function creerRouteur(routes, { pasTrouve } = {}) {",
      "  function resoudre() {",
      "    const chemin = location.hash.slice(1) || \"/\";",
      "    for (const [motif, action] of Object.entries(routes)) {",
      "      const params = correspondreRoute(motif, chemin);",
      "      if (params) return action(params);",
      "    }",
      "    pasTrouve?.(chemin);",
      "  }",
      "  addEventListener(\"hashchange\", resoudre);",
      "  resoudre();",
      "  return { aller: (chemin) => (location.hash = chemin), resoudre };",
      "}"
    ]
  },
  "web/app/store": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-store",
    "description": "Store d'état global avec abonnements (mini Redux)",
    "body": [
      "// État global minimal avec abonnements (alternative légère à Redux / Pinia / Zustand).",
      "export function creerStore(etatInitial) {",
      "  let etat = etatInitial;",
      "  const abonnes = new Set();",
      "  return {",
      "    lire: () => etat,",
      "    // modifier({ champ: valeur }) ou modifier((etat) => nouvelEtat)",
      "    modifier(maj) {",
      "      const suivant = typeof maj === \"function\" ? maj(etat) : { ...etat, ...maj };",
      "      if (suivant === etat) return;",
      "      etat = suivant;",
      "      abonnes.forEach((f) => f(etat));",
      "    },",
      "    abonner(f) {",
      "      abonnes.add(f);",
      "      return () => abonnes.delete(f);",
      "    },",
      "  };",
      "}"
    ]
  },
  "web/app/tableau-donnees": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-recherche-tri",
    "description": "Recherche sans accents + tri naturel sur une liste d'objets",
    "body": [
      "// Recherche et tri sur une liste d'objets (tableaux, listes de produits, contacts…).",
      "const normaliser = (v) =>",
      "  String(v ?? \"\")",
      "    .normalize(\"NFD\")",
      "    .replace(/[̀-ͯ]/g, \"\")",
      "    .toLowerCase();",
      "",
      "// Recherche insensible aux accents et à la casse dans les champs indiqués.",
      "export function rechercher(elements, requete, champs) {",
      "  const q = normaliser(requete).trim();",
      "  if (!q) return elements;",
      "  return elements.filter((el) => champs.some((c) => normaliser(el[c]).includes(q)));",
      "}",
      "",
      "// Tri naturel (\"article 2\" avant \"article 10\"), nombres et textes.",
      "export function trierPar(elements, champ, sens = \"asc\") {",
      "  const facteur = sens === \"desc\" ? -1 : 1;",
      "  const collator = new Intl.Collator(\"fr\", { numeric: true, sensitivity: \"base\" });",
      "  return [...elements].sort((a, b) => {",
      "    const x = a[champ];",
      "    const y = b[champ];",
      "    if (typeof x === \"number\" && typeof y === \"number\") return (x - y) * facteur;",
      "    return collator.compare(String(x ?? \"\"), String(y ?? \"\")) * facteur;",
      "  });",
      "}"
    ]
  },
  "web/app/toasts": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-toast",
    "description": "Notifications temporaires (succès, erreur…) sans dépendance",
    "body": [
      "// Petites notifications temporaires en bas de l'écran, lues par les lecteurs d'écran.",
      "let zone;",
      "",
      "function obtenirZone() {",
      "  if (!zone) {",
      "    zone = document.createElement(\"div\");",
      "    zone.setAttribute(\"role\", \"status\");",
      "    zone.setAttribute(\"aria-live\", \"polite\");",
      "    Object.assign(zone.style, {",
      "      position: \"fixed\",",
      "      bottom: \"16px\",",
      "      left: \"50%\",",
      "      transform: \"translateX(-50%)\",",
      "      display: \"flex\",",
      "      flexDirection: \"column\",",
      "      gap: \"8px\",",
      "      zIndex: 9999,",
      "    });",
      "    document.body.append(zone);",
      "  }",
      "  return zone;",
      "}",
      "",
      "const COULEURS = { info: \"#2563eb\", succes: \"#15803d\", erreur: \"#b91c1c\", alerte: \"#b45309\" };",
      "",
      "export function toast(message, { type = \"info\", duree = 3000 } = {}) {",
      "  const el = document.createElement(\"div\");",
      "  el.textContent = message;",
      "  Object.assign(el.style, {",
      "    background: COULEURS[type] ?? COULEURS.info,",
      "    color: \"#fff\",",
      "    padding: \"10px 16px\",",
      "    borderRadius: \"8px\",",
      "    boxShadow: \"0 4px 12px rgba(0,0,0,.2)\",",
      "    font: \"14px system-ui, sans-serif\",",
      "    maxWidth: \"90vw\",",
      "    transition: \"opacity .3s\",",
      "  });",
      "  obtenirZone().append(el);",
      "  setTimeout(() => {",
      "    el.style.opacity = \"0\";",
      "    setTimeout(() => el.remove(), 300);",
      "  }, duree);",
      "}"
    ]
  },
  "web/app/upload-fichiers": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-upload",
    "description": "Glisser-déposer de fichiers avec contrôle type/taille et aperçu",
    "body": [
      "// Zone de glisser-déposer (+ clic) avec contrôle du type et de la taille des fichiers.",
      "export function zoneDepot(zone, { accepter = [], tailleMaxMo = 5, multiple = true, surFichiers, surErreur } = {}) {",
      "  const input = Object.assign(document.createElement(\"input\"), { type: \"file\", multiple, hidden: true });",
      "  if (accepter.length) input.accept = accepter.join(\",\");",
      "  document.body.append(input);",
      "",
      "  const typeAccepte = (f) =>",
      "    !accepter.length ||",
      "    accepter.some((t) =>",
      "      t.endsWith(\"/*\") ? f.type.startsWith(t.slice(0, -1)) : f.type === t || f.name.toLowerCase().endsWith(t)",
      "    );",
      "",
      "  const traiter = (liste) => {",
      "    const valides = [];",
      "    for (const f of [...liste].slice(0, multiple ? undefined : 1)) {",
      "      if (!typeAccepte(f)) surErreur?.(`\\${f.name} : type de fichier non autorisé`);",
      "      else if (f.size > tailleMaxMo * 1024 * 1024) surErreur?.(`\\${f.name} : dépasse \\${tailleMaxMo} Mo`);",
      "      else valides.push(f);",
      "    }",
      "    if (valides.length) surFichiers?.(valides);",
      "  };",
      "",
      "  zone.addEventListener(\"click\", () => input.click());",
      "  input.addEventListener(\"change\", () => {",
      "    traiter(input.files);",
      "    input.value = \"\";",
      "  });",
      "  zone.addEventListener(\"dragover\", (e) => {",
      "    e.preventDefault();",
      "    zone.classList.add(\"survol\");",
      "  });",
      "  zone.addEventListener(\"dragleave\", () => zone.classList.remove(\"survol\"));",
      "  zone.addEventListener(\"drop\", (e) => {",
      "    e.preventDefault();",
      "    zone.classList.remove(\"survol\");",
      "    traiter(e.dataTransfer.files);",
      "  });",
      "}",
      "",
      "// URL temporaire pour afficher une image avant envoi : <img src=...>",
      "export function apercuImage(fichier) {",
      "  return URL.createObjectURL(fichier);",
      "}"
    ]
  },
  "web/banque/argent": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-argent",
    "description": "Montants en centimes, saisie, formatage €/F CFA, répartition, taux",
    "body": [
      "// Calculs d'argent sans erreurs d'arrondi.",
      "// Règle d'or : on stocke et calcule en UNITÉS MINEURES ENTIÈRES",
      "// (centimes pour EUR/USD, francs pour XOF qui n'a pas de décimales).",
      "// 0.1 + 0.2 = 0.30000000000000004 en JavaScript : jamais de float pour de l'argent.",
      "",
      "// Nombre de décimales d'une devise : EUR → 2, XOF → 0, JPY → 0, TND → 3",
      "export function decimalesDevise(devise) {",
      "  return new Intl.NumberFormat(\"en\", { style: \"currency\", currency: devise }).resolvedOptions()",
      "    .maximumFractionDigits;",
      "}",
      "",
      "// Texte saisi → unités mineures. \"1 234,56\" (EUR) → 123456 ; \"1.500\" (XOF) → 1500",
      "export function versUnitesMineures(texte, devise = \"EUR\") {",
      "  const decimales = decimalesDevise(devise);",
      "  const propre = String(texte).trim().replace(/[\\\\s  ']/g, \"\").replace(/[^\\\\d.,-]/g, \"\");",
      "  const negatif = propre.startsWith(\"-\");",
      "  const corps = propre.replace(/^-/, \"\");",
      "  const invalide = () => new Error(`Montant invalide : \\${texte}`);",
      "  if (!/^\\\\d+([.,]\\\\d+)*\\$/.test(corps)) throw invalide();",
      "",
      "  const morceaux = corps.split(/[.,]/);",
      "  let fraction = \"\";",
      "  if (morceaux.length > 1 && decimales > 0 && morceaux.at(-1).length <= decimales) {",
      "    fraction = morceaux.pop();",
      "  }",
      "  // Ce qui reste doit être des milliers bien formés : \"1\", \"234\", \"567\"",
      "  if (morceaux.length > 1 && (morceaux[0].length > 3 || morceaux.slice(1).some((m) => m.length !== 3))) {",
      "    throw invalide();",
      "  }",
      "  const unites = Number(morceaux.join(\"\") + fraction.padEnd(decimales, \"0\"));",
      "  if (!Number.isSafeInteger(unites)) throw invalide();",
      "  return negatif ? -unites : unites;",
      "}",
      "",
      "export function depuisUnitesMineures(unites, devise = \"EUR\") {",
      "  return unites / 10 ** decimalesDevise(devise);",
      "}",
      "",
      "// 123456 → \"1 234,56 €\" ; 1500 XOF → \"1 500 F CFA\"",
      "export function formaterMontant(unites, devise = \"EUR\", { langue = \"fr-FR\", signe = \"auto\" } = {}) {",
      "  return new Intl.NumberFormat(langue, { style: \"currency\", currency: devise, signDisplay: signe }).format(",
      "    depuisUnitesMineures(unites, devise)",
      "  );",
      "}",
      "",
      "// Répartit un montant sans perdre une unité.",
      "// repartir(1000, 3) → [334, 333, 333] ; repartir(1000, [70, 30]) → [700, 300]",
      "export function repartir(unites, partsOuRatios) {",
      "  const ratios = Array.isArray(partsOuRatios) ? partsOuRatios : Array(partsOuRatios).fill(1);",
      "  const total = ratios.reduce((a, b) => a + b, 0);",
      "  const absolu = Math.abs(unites);",
      "  const resultats = ratios.map((r) => Math.floor((absolu * r) / total));",
      "  let reste = absolu - resultats.reduce((a, b) => a + b, 0);",
      "  for (let i = 0; reste > 0; i = (i + 1) % ratios.length, reste--) resultats[i]++;",
      "  return unites < 0 ? resultats.map((r) => -r) : resultats;",
      "}",
      "",
      "// Applique un pourcentage (frais, TVA, remise), arrondi au plus proche.",
      "// appliquerTaux(10000, 1.5) → 150 (1,5 % de 100,00 €)",
      "export function appliquerTaux(unites, tauxPourcent) {",
      "  const brut = (unites * tauxPourcent) / 100;",
      "  return Math.sign(brut) * Math.round(Math.abs(brut));",
      "}"
    ]
  },
  "web/banque/carte-bancaire": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-carte",
    "description": "Carte bancaire : Luhn, réseau (Visa…), formatage, expiration, CVC",
    "body": [
      "// Contrôles de saisie d'une carte bancaire (affichage / confort uniquement, voir README).",
      "",
      "// Algorithme de Luhn : détecte les fautes de frappe dans un numéro de carte.",
      "export function validerLuhn(numero) {",
      "  const chiffres = String(numero).replace(/[\\\\s-]/g, \"\");",
      "  if (!/^\\\\d{12,19}\\$/.test(chiffres)) return false;",
      "  let somme = 0;",
      "  for (let i = 0; i < chiffres.length; i++) {",
      "    let c = Number(chiffres[chiffres.length - 1 - i]);",
      "    if (i % 2 === 1) {",
      "      c *= 2;",
      "      if (c > 9) c -= 9;",
      "    }",
      "    somme += c;",
      "  }",
      "  return somme % 10 === 0;",
      "}",
      "",
      "const RESEAUX = [",
      "  [\"amex\", /^3[47]/],",
      "  [\"visa\", /^4/],",
      "  [\"mastercard\", /^(5[1-5]|222[1-9]|22[3-9]\\\\d|2[3-6]\\\\d\\\\d|27[01]\\\\d|2720)/],",
      "  [\"discover\", /^6(011|5)/],",
      "  [\"jcb\", /^35(2[89]|[3-8]\\\\d)/],",
      "  [\"unionpay\", /^62/],",
      "];",
      "",
      "export function detecterReseau(numero) {",
      "  const chiffres = String(numero).replace(/\\\\D/g, \"\");",
      "  return RESEAUX.find(([, motif]) => motif.test(chiffres))?.[0] ?? null;",
      "}",
      "",
      "// \"4111111111111111\" → \"4111 1111 1111 1111\" ; Amex : \"3782 822463 10005\"",
      "export function formaterNumeroCarte(numero) {",
      "  const chiffres = String(numero).replace(/\\\\D/g, \"\").slice(0, 19);",
      "  if (detecterReseau(chiffres) === \"amex\") {",
      "    return [chiffres.slice(0, 4), chiffres.slice(4, 10), chiffres.slice(10, 15)].filter(Boolean).join(\" \");",
      "  }",
      "  return chiffres.replace(/(\\\\d{4})(?=\\\\d)/g, \"\\$1 \");",
      "}",
      "",
      "// \"08/27\" → true si la carte n'est pas expirée (valable jusqu'à la fin du mois)",
      "export function validerExpiration(texte, maintenant = new Date()) {",
      "  const m = String(texte).match(/^\\\\s*(0[1-9]|1[0-2])\\\\s*\\\\/\\\\s*(\\\\d{2}|\\\\d{4})\\\\s*\\$/);",
      "  if (!m) return false;",
      "  const mois = Number(m[1]);",
      "  const annee = m[2].length === 2 ? 2000 + Number(m[2]) : Number(m[2]);",
      "  return new Date(annee, mois, 1) > maintenant;",
      "}",
      "",
      "export function validerCvc(cvc, reseau) {",
      "  return new RegExp(`^\\\\\\\\d{\\${reseau === \"amex\" ? 4 : 3}}\\$`).test(String(cvc));",
      "}"
    ]
  },
  "web/banque/devises": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-devises",
    "description": "Conversion de devises (EUR ↔ F CFA, USD…) en unités mineures",
    "body": [
      "// Conversion entre devises, en unités mineures, à partir d'une table de taux.",
      "// taux = combien d'unités de chaque devise pour 1 unité de la devise de base.",
      "// Ex. base EUR : { EUR: 1, XOF: 655.957, USD: 1.08 }",
      "const decimales = (devise) =>",
      "  new Intl.NumberFormat(\"en\", { style: \"currency\", currency: devise }).resolvedOptions().maximumFractionDigits;",
      "",
      "export function convertir(unites, de, vers, taux) {",
      "  if (!(de in taux) || !(vers in taux)) throw new Error(`Taux manquant pour \\${de} ou \\${vers}`);",
      "  const montant = unites / 10 ** decimales(de);",
      "  const converti = (montant / taux[de]) * taux[vers];",
      "  return Math.round(converti * 10 ** decimales(vers));",
      "}",
      "",
      "// Parité fixe officielle : 1 EUR = 655,957 XOF (franc CFA UEMOA) = 655,957 XAF (CEMAC)",
      "export const PARITE_FCFA = { EUR: 1, XOF: 655.957, XAF: 655.957 };"
    ]
  },
  "web/banque/iban": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-iban",
    "description": "Validation IBAN (mod 97) et BIC, formatage par blocs de 4",
    "body": [
      "// Validation IBAN (clé de contrôle mod 97 + longueur par pays), BIC, formatage.",
      "const LONGUEURS = {",
      "  // Europe",
      "  FR: 27, BE: 16, DE: 22, ES: 24, IT: 27, LU: 20, CH: 21, MC: 27, PT: 25, NL: 18, GB: 22,",
      "  // Afrique (UEMOA : 28 caractères ; CEMAC : 27)",
      "  CI: 28, SN: 28, ML: 28, BF: 28, BJ: 28, TG: 28, NE: 28, GW: 25, CM: 27, CG: 27, GA: 27,",
      "  MA: 28, TN: 24, DZ: 26, MG: 27,",
      "};",
      "",
      "export function normaliserIban(iban) {",
      "  return String(iban).replace(/\\\\s+/g, \"\").toUpperCase();",
      "}",
      "",
      "export function validerIban(iban) {",
      "  const v = normaliserIban(iban);",
      "  if (!/^[A-Z]{2}\\\\d{2}[A-Z0-9]{11,30}\\$/.test(v)) return false;",
      "  const attendue = LONGUEURS[v.slice(0, 2)];",
      "  if (attendue && v.length !== attendue) return false;",
      "",
      "  // On déplace les 4 premiers caractères à la fin, lettres → nombres (A=10…Z=35), puis mod 97.",
      "  let reste = 0;",
      "  for (const c of v.slice(4) + v.slice(0, 4)) {",
      "    const n = c >= \"A\" ? c.charCodeAt(0) - 55 : Number(c);",
      "    reste = (reste * (n > 9 ? 100 : 10) + n) % 97;",
      "  }",
      "  return reste === 1;",
      "}",
      "",
      "// \"FR7630006000011234567890189\" → \"FR76 3000 6000 0112 3456 7890 189\"",
      "export function formaterIban(iban) {",
      "  return normaliserIban(iban).replace(/(.{4})(?=.)/g, \"\\$1 \");",
      "}",
      "",
      "// BIC / SWIFT : 8 ou 11 caractères (banque, pays, ville, agence)",
      "export function validerBic(bic) {",
      "  return /^[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?\\$/.test(String(bic).replace(/\\\\s+/g, \"\").toUpperCase());",
      "}"
    ]
  },
  "web/banque/inactivite": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-inactivite",
    "description": "Déconnexion auto après inactivité avec avertissement",
    "body": [
      "// Déconnexion automatique après une période d'inactivité, avec avertissement avant.",
      "// Fonctionne même si l'onglet est resté en arrière-plan (les minuteurs y sont ralentis).",
      "export function surveillerInactivite({ dureeMs = 5 * 60_000, avertirAvantMs = 60_000, surAvertissement, surExpiration }) {",
      "  const evenements = [\"pointerdown\", \"keydown\", \"scroll\", \"touchstart\"];",
      "  let derniereActivite = Date.now();",
      "  let averti = false;",
      "",
      "  const verifier = () => {",
      "    const inactif = Date.now() - derniereActivite;",
      "    if (inactif >= dureeMs) {",
      "      arreter();",
      "      surExpiration();",
      "    } else if (!averti && inactif >= dureeMs - avertirAvantMs) {",
      "      averti = true;",
      "      surAvertissement?.(dureeMs - inactif);",
      "    }",
      "  };",
      "",
      "  const relancer = () => {",
      "    derniereActivite = Date.now();",
      "    averti = false;",
      "  };",
      "",
      "  const surVisibilite = () => document.visibilityState === \"visible\" && verifier();",
      "  const intervalle = setInterval(verifier, 1000);",
      "",
      "  function arreter() {",
      "    clearInterval(intervalle);",
      "    evenements.forEach((e) => removeEventListener(e, relancer));",
      "    document.removeEventListener(\"visibilitychange\", surVisibilite);",
      "  }",
      "",
      "  evenements.forEach((e) => addEventListener(e, relancer, { passive: true }));",
      "  document.addEventListener(\"visibilitychange\", surVisibilite);",
      "  return { relancer, arreter };",
      "}"
    ]
  },
  "web/banque/masquage": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-masquer",
    "description": "Masquer IBAN, numéro de carte, téléphone, email (••••)",
    "body": [
      "// Masque une donnée sensible en ne laissant visibles que les derniers caractères.",
      "// masquer(\"FR76 3000 6000 0112 3456 7890 189\") → \"•••• •••• •••• •••• •••• ••90 189\"",
      "export function masquer(valeur, { visibles = 4, caractere = \"•\" } = {}) {",
      "  const texte = String(valeur);",
      "  const total = texte.replace(/\\\\s/g, \"\").length;",
      "  let index = 0;",
      "  return [...texte].map((c) => (/\\\\s/.test(c) ? c : index++ < total - visibles ? caractere : c)).join(\"\");",
      "}",
      "",
      "// \"awa.kone@mail.com\" → \"a•••••••@mail.com\"",
      "export function masquerEmail(email) {",
      "  const [nom, domaine] = String(email).split(\"@\");",
      "  if (!domaine) return masquer(email);",
      "  return nom.slice(0, 1) + \"•\".repeat(Math.max(nom.length - 1, 3)) + \"@\" + domaine;",
      "}"
    ]
  },
  "web/banque/mobile-money": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-mobile-money",
    "description": "Numéros ivoiriens : validation, formatage, opérateur (Orange, MTN, Moov)",
    "body": [
      "// Numéros ivoiriens (10 chiffres depuis 2021) et opérateur mobile money.",
      "const MOBILES = { \"01\": \"Moov Africa\", \"05\": \"MTN\", \"07\": \"Orange\" };",
      "const FIXES = { 21: \"Moov Africa\", 25: \"MTN\", 27: \"Orange\" };",
      "",
      "// \"+225 07 07 12 34 56\" / \"00225...\" / \"07.07.12.34.56\" → \"0707123456\", ou null si invalide",
      "export function normaliserTelephoneCI(numero) {",
      "  let n = String(numero ?? \"\").replace(/[\\\\s.\\\\-()]/g, \"\");",
      "  if (n.startsWith(\"+225\")) n = n.slice(4);",
      "  else if (n.startsWith(\"00225\")) n = n.slice(5);",
      "  else if (n.length === 13 && n.startsWith(\"225\")) n = n.slice(3);",
      "  return /^\\\\d{10}\\$/.test(n) && (MOBILES[n.slice(0, 2)] || FIXES[n.slice(0, 2)]) ? n : null;",
      "}",
      "",
      "// { operateur: \"Orange\", type: \"mobile\" } ou null",
      "export function operateurCI(numero) {",
      "  const n = normaliserTelephoneCI(numero);",
      "  if (!n) return null;",
      "  const prefixe = n.slice(0, 2);",
      "  if (MOBILES[prefixe]) return { operateur: MOBILES[prefixe], type: \"mobile\" };",
      "  return { operateur: FIXES[prefixe], type: \"fixe\" };",
      "}",
      "",
      "// \"0707123456\" → \"07 07 12 34 56\" ; { international: true } → \"+225 07 07 12 34 56\"",
      "export function formaterTelephoneCI(numero, { international = false } = {}) {",
      "  const n = normaliserTelephoneCI(numero);",
      "  if (!n) return String(numero ?? \"\");",
      "  const groupes = n.match(/\\\\d{2}/g).join(\" \");",
      "  return international ? `+225 \\${groupes}` : groupes;",
      "}",
      "",
      "// Format attendu par la plupart des API de paiement : \"2250707123456\"",
      "export function telephoneInternationalCI(numero) {",
      "  const n = normaliserTelephoneCI(numero);",
      "  return n ? `225\\${n}` : null;",
      "}"
    ]
  },
  "web/banque/montant-en-lettres": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-lettres",
    "description": "Montant en toutes lettres en français (factures, chèques, contrats)",
    "body": [
      "// Écrit un nombre ou un montant en toutes lettres, en français (factures, chèques, contrats).",
      "const UNITES = [\"zéro\", \"un\", \"deux\", \"trois\", \"quatre\", \"cinq\", \"six\", \"sept\", \"huit\", \"neuf\", \"dix\",",
      "  \"onze\", \"douze\", \"treize\", \"quatorze\", \"quinze\", \"seize\", \"dix-sept\", \"dix-huit\", \"dix-neuf\"];",
      "const DIZAINES = [\"\", \"\", \"vingt\", \"trente\", \"quarante\", \"cinquante\", \"soixante\", \"soixante\", \"quatre-vingt\", \"quatre-vingt\"];",
      "",
      "function moinsDeCent(n) {",
      "  if (n < 20) return UNITES[n];",
      "  const d = Math.floor(n / 10);",
      "  const u = n % 10;",
      "  if (d === 7 || d === 9) return DIZAINES[d] + (d === 7 && u === 1 ? \" et \" : \"-\") + UNITES[10 + u];",
      "  if (u === 0) return d === 8 ? \"quatre-vingts\" : DIZAINES[d];",
      "  if (u === 1 && d !== 8) return `\\${DIZAINES[d]} et un`;",
      "  return `\\${DIZAINES[d]}-\\${UNITES[u]}`;",
      "}",
      "",
      "// avantMille : « quatre-vingt mille », « deux cent mille » (pas de s devant mille)",
      "function moinsDeMille(n, avantMille = false) {",
      "  const c = Math.floor(n / 100);",
      "  const r = n % 100;",
      "  let texte;",
      "  if (c === 0) texte = moinsDeCent(r);",
      "  else if (c === 1) texte = r ? `cent \\${moinsDeCent(r)}` : \"cent\";",
      "  else texte = r ? `\\${UNITES[c]} cent \\${moinsDeCent(r)}` : `\\${UNITES[c]} cents`;",
      "  return avantMille ? texte.replace(/(cent|vingt)s\\$/, \"\\$1\") : texte;",
      "}",
      "",
      "// nombreEnLettres(1234) → \"mille deux cent trente-quatre\"",
      "export function nombreEnLettres(n) {",
      "  if (!Number.isSafeInteger(n) || n < 0 || n >= 1e12) throw new Error(`Nombre non géré : \\${n}`);",
      "  if (n === 0) return \"zéro\";",
      "  const parties = [];",
      "  let reste = n;",
      "  for (const [valeur, nom] of [[1e9, \"milliard\"], [1e6, \"million\"]]) {",
      "    const q = Math.floor(reste / valeur);",
      "    if (q) parties.push(`\\${moinsDeMille(q)} \\${nom}\\${q > 1 ? \"s\" : \"\"}`);",
      "    reste %= valeur;",
      "  }",
      "  const milliers = Math.floor(reste / 1000);",
      "  if (milliers) parties.push(milliers === 1 ? \"mille\" : `\\${moinsDeMille(milliers, true)} mille`);",
      "  reste %= 1000;",
      "  if (reste) parties.push(moinsDeMille(reste));",
      "  return parties.join(\" \");",
      "}",
      "",
      "const NOMS = {",
      "  EUR: [\"euro\", \"euros\", \"centime\", \"centimes\"],",
      "  XOF: [\"franc CFA\", \"francs CFA\"],",
      "  XAF: [\"franc CFA\", \"francs CFA\"],",
      "  USD: [\"dollar\", \"dollars\", \"cent\", \"cents\"],",
      "  GBP: [\"livre sterling\", \"livres sterling\", \"penny\", \"pence\"],",
      "};",
      "const decimalesDevise = (devise) =>",
      "  new Intl.NumberFormat(\"en\", { style: \"currency\", currency: devise }).resolvedOptions().maximumFractionDigits;",
      "",
      "// montantEnLettres(123456, \"EUR\") → \"mille deux cent trente-quatre euros et cinquante-six centimes\"",
      "export function montantEnLettres(unites, devise = \"EUR\") {",
      "  const noms = NOMS[devise];",
      "  if (!noms) throw new Error(`Devise non gérée : \\${devise}`);",
      "  const facteur = 10 ** decimalesDevise(devise);",
      "  const absolu = Math.abs(unites);",
      "  const entier = Math.floor(absolu / facteur);",
      "  const fraction = absolu % facteur;",
      "",
      "  // « un million d'euros », « deux milliards de francs CFA »",
      "  const de = entier >= 1e6 && entier % 1e6 === 0 ? (/^[aeiouy]/.test(noms[1]) ? \"d'\" : \"de \") : \"\";",
      "  let texte = `\\${nombreEnLettres(entier)} \\${de}\\${entier > 1 ? noms[1] : noms[0]}`;",
      "  if (fraction && noms[2]) texte += ` et \\${nombreEnLettres(fraction)} \\${fraction > 1 ? noms[3] : noms[2]}`;",
      "  return (unites < 0 ? \"moins \" : \"\") + texte;",
      "}"
    ]
  },
  "web/banque/pret": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-pret",
    "description": "Simulateur de prêt : mensualité, tableau d'amortissement, coût total",
    "body": [
      "// Simulateur de prêt à taux fixe (mensualités constantes). Montants en unités mineures.",
      "",
      "// mensualite(10_000_000, 3.5, 240) → 57996 (100 000 € à 3,5 % sur 20 ans = 579,96 €/mois)",
      "export function mensualite(capital, tauxAnnuelPourcent, dureeMois) {",
      "  const t = tauxAnnuelPourcent / 100 / 12;",
      "  if (t === 0) return Math.round(capital / dureeMois);",
      "  return Math.round((capital * t) / (1 - (1 + t) ** -dureeMois));",
      "}",
      "",
      "// Une ligne par mois : { mois, mensualite, interets, principal, restant }",
      "export function tableauAmortissement(capital, tauxAnnuelPourcent, dureeMois) {",
      "  const t = tauxAnnuelPourcent / 100 / 12;",
      "  const paiement = mensualite(capital, tauxAnnuelPourcent, dureeMois);",
      "  const lignes = [];",
      "  let restant = capital;",
      "  for (let mois = 1; mois <= dureeMois; mois++) {",
      "    const interets = Math.round(restant * t);",
      "    // La dernière échéance solde exactement le capital restant.",
      "    const principal = mois === dureeMois ? restant : paiement - interets;",
      "    restant -= principal;",
      "    lignes.push({ mois, mensualite: principal + interets, interets, principal, restant });",
      "  }",
      "  return lignes;",
      "}",
      "",
      "// Total des intérêts payés sur toute la durée",
      "export function coutTotalCredit(capital, tauxAnnuelPourcent, dureeMois) {",
      "  return tableauAmortissement(capital, tauxAnnuelPourcent, dureeMois).reduce((s, l) => s + l.interets, 0);",
      "}"
    ]
  },
  "web/banque/transactions": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-transactions",
    "description": "Solde, totaux par catégorie, regroupement par mois, filtres, export CSV",
    "body": [
      "// Outils pour une liste de transactions :",
      "// { date: \"2026-10-05\", libelle, montant (unités mineures, négatif = débit), categorie }",
      "",
      "export function soldeTransactions(transactions, soldeInitial = 0) {",
      "  return transactions.reduce((solde, t) => solde + t.montant, soldeInitial);",
      "}",
      "",
      "// { courses: { debits: -45000, credits: 0, nombre: 3 }, salaire: {...} }",
      "export function totauxParCategorie(transactions) {",
      "  const totaux = {};",
      "  for (const t of transactions) {",
      "    const c = (totaux[t.categorie ?? \"autre\"] ??= { debits: 0, credits: 0, nombre: 0 });",
      "    if (t.montant < 0) c.debits += t.montant;",
      "    else c.credits += t.montant;",
      "    c.nombre++;",
      "  }",
      "  return totaux;",
      "}",
      "",
      "const cleMois = (date) => {",
      "  if (typeof date === \"string\" && /^\\\\d{4}-\\\\d{2}/.test(date)) return date.slice(0, 7);",
      "  const d = new Date(date);",
      "  return `\\${d.getFullYear()}-\\${String(d.getMonth() + 1).padStart(2, \"0\")}`;",
      "};",
      "",
      "// Map \"2026-10\" → [transactions], du mois le plus récent au plus ancien",
      "export function regrouperParMois(transactions) {",
      "  const groupes = new Map();",
      "  const triees = [...transactions].sort((a, b) => String(b.date).localeCompare(String(a.date)));",
      "  for (const t of triees) {",
      "    const cle = cleMois(t.date);",
      "    if (!groupes.has(cle)) groupes.set(cle, []);",
      "    groupes.get(cle).push(t);",
      "  }",
      "  return groupes;",
      "}",
      "",
      "// Filtres : du/au (dates \"AAAA-MM-JJ\" incluses), min/max (valeur absolue), type, categorie, recherche",
      "export function filtrerTransactions(transactions, { du, au, min, max, type, categorie, recherche } = {}) {",
      "  const q = recherche?.toLowerCase().trim();",
      "  return transactions.filter((t) => {",
      "    const jour = String(t.date).slice(0, 10);",
      "    const abs = Math.abs(t.montant);",
      "    return (",
      "      (!du || jour >= du) &&",
      "      (!au || jour <= au) &&",
      "      (min === undefined || abs >= min) &&",
      "      (max === undefined || abs <= max) &&",
      "      (!type || (type === \"debit\" ? t.montant < 0 : t.montant > 0)) &&",
      "      (!categorie || t.categorie === categorie) &&",
      "      (!q || t.libelle.toLowerCase().includes(q))",
      "    );",
      "  });",
      "}",
      "",
      "// CSV lisible par Excel (séparateur ;, virgule décimale, BOM UTF-8).",
      "// Protège contre l'injection de formules (=, +, -, @ en début de libellé).",
      "export function exporterCsv(transactions, { decimales = 2, separateur = \";\" } = {}) {",
      "  const texte = (v) => {",
      "    let s = String(v ?? \"\");",
      "    if (/^[=+\\\\-@\\\\t\\\\r]/.test(s)) s = \"'\" + s;",
      "    return /[\";\\\\n\\\\r]/.test(s) || s.includes(separateur) ? `\"\\${s.replace(/\"/g, '\"\"')}\"` : s;",
      "  };",
      "  const montant = (u) => (u / 10 ** decimales).toFixed(decimales).replace(\".\", \",\");",
      "  const lignes = [[\"Date\", \"Libellé\", \"Catégorie\", \"Montant\"].join(separateur)];",
      "  for (const t of transactions) {",
      "    lignes.push([String(t.date).slice(0, 10), texte(t.libelle), texte(t.categorie), montant(t.montant)].join(separateur));",
      "  }",
      "  return \"﻿\" + lignes.join(\"\\\\r\\\\n\");",
      "}"
    ]
  },
  "web/formulaires/champ-otp": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-otp",
    "description": "Champ code SMS / 2FA à cases (collage et auto-remplissage)",
    "body": [
      "// Transforme les <input> d'un conteneur en champ de code à usage unique (code SMS, 2FA).",
      "// Gère : passage automatique à la case suivante, retour arrière, collage, remplissage auto du SMS.",
      "export function champOtp(conteneur, { surComplet } = {}) {",
      "  const cases = [...conteneur.querySelectorAll(\"input\")];",
      "  const valeur = () => cases.map((c) => c.value).join(\"\");",
      "  const verifierComplet = () => {",
      "    if (valeur().length === cases.length) surComplet?.(valeur());",
      "  };",
      "",
      "  const remplir = (debut, chiffres) => {",
      "    [...chiffres].slice(0, cases.length - debut).forEach((c, j) => (cases[debut + j].value = c));",
      "    cases[Math.min(debut + chiffres.length, cases.length - 1)].focus();",
      "  };",
      "",
      "  cases.forEach((input, i) => {",
      "    input.inputMode = \"numeric\";",
      "    input.autocomplete = i === 0 ? \"one-time-code\" : \"off\";",
      "    input.setAttribute(\"aria-label\", `Chiffre \\${i + 1} sur \\${cases.length}`);",
      "",
      "    input.addEventListener(\"input\", () => {",
      "      const chiffres = input.value.replace(/\\\\D/g, \"\");",
      "      if (chiffres.length > 1) {",
      "        remplir(i, chiffres);",
      "      } else {",
      "        input.value = chiffres;",
      "        if (chiffres && i < cases.length - 1) cases[i + 1].focus();",
      "      }",
      "      verifierComplet();",
      "    });",
      "",
      "    input.addEventListener(\"keydown\", (e) => {",
      "      if (e.key === \"Backspace\" && !input.value && i > 0) cases[i - 1].focus();",
      "    });",
      "",
      "    input.addEventListener(\"paste\", (e) => {",
      "      e.preventDefault();",
      "      remplir(i, e.clipboardData.getData(\"text\").replace(/\\\\D/g, \"\"));",
      "      verifierComplet();",
      "    });",
      "  });",
      "",
      "  return {",
      "    valeur,",
      "    vider() {",
      "      cases.forEach((c) => (c.value = \"\"));",
      "      cases[0].focus();",
      "    },",
      "  };",
      "}"
    ]
  },
  "web/formulaires/mot-de-passe": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-mdp",
    "description": "Indicateur de force du mot de passe avec critères",
    "body": [
      "// Évalue la force d'un mot de passe : score de 0 à 5 + critères pour l'affichage.",
      "export function forceMotDePasse(mdp) {",
      "  const criteres = {",
      "    longueur: mdp.length >= 12,",
      "    minuscule: /[a-z]/.test(mdp),",
      "    majuscule: /[A-Z]/.test(mdp),",
      "    chiffre: /\\\\d/.test(mdp),",
      "    special: /[^A-Za-z0-9]/.test(mdp),",
      "  };",
      "  let score = Object.values(criteres).filter(Boolean).length;",
      "  if (mdp.length < 8) score = Math.min(score, 1);",
      "  if (/(.)\\\\1{2,}/.test(mdp)) score = Math.max(score - 1, 0); // \"aaa\", \"111\"",
      "  const niveaux = [\"très faible\", \"très faible\", \"faible\", \"moyen\", \"fort\", \"très fort\"];",
      "  return { score, niveau: niveaux[score], criteres };",
      "}"
    ]
  },
  "web/formulaires/soumission-unique": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-anti-doublon",
    "description": "Anti double envoi / double paiement + clé d'idempotence",
    "body": [
      "// Empêche les doubles envois (double clic sur « Payer », réseau lent…).",
      "",
      "// Tant que l'action est en cours, les appels suivants renvoient la même promesse.",
      "export function uneSeuleFois(action) {",
      "  let enCours = null;",
      "  return (...args) =>",
      "    (enCours ??= Promise.resolve()",
      "      .then(() => action(...args))",
      "      .finally(() => (enCours = null)));",
      "}",
      "",
      "// Désactive le bouton d'envoi et affiche un texte de chargement pendant `action(formData)`.",
      "export function formulaireSoumissionUnique(formulaire, action, { texteChargement = \"Envoi en cours…\" } = {}) {",
      "  const bouton = formulaire.querySelector('[type=\"submit\"], button:not([type])');",
      "  const executer = uneSeuleFois(action);",
      "  formulaire.addEventListener(\"submit\", async (e) => {",
      "    e.preventDefault();",
      "    const texte = bouton?.textContent;",
      "    if (bouton) {",
      "      bouton.disabled = true;",
      "      bouton.setAttribute(\"aria-busy\", \"true\");",
      "      bouton.textContent = texteChargement;",
      "    }",
      "    try {",
      "      await executer(new FormData(formulaire));",
      "    } finally {",
      "      if (bouton) {",
      "        bouton.disabled = false;",
      "        bouton.removeAttribute(\"aria-busy\");",
      "        bouton.textContent = texte;",
      "      }",
      "    }",
      "  });",
      "}",
      "",
      "// Clé à générer UNE fois par opération et à envoyer au serveur (en-tête Idempotency-Key) :",
      "// si la requête est rejouée, le serveur reconnaît la clé et n'exécute pas l'opération deux fois.",
      "export function cleIdempotence() {",
      "  return crypto.randomUUID();",
      "}"
    ]
  },
  "web/formulaires/validation": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-validation",
    "description": "Validation de formulaires (email, téléphone CI/FR, URL…)",
    "body": [
      "// Règles de validation courantes. Chaque règle reçoit la valeur et renvoie true/false.",
      "export const valider = {",
      "  nonVide: (v) => String(v ?? \"\").trim().length > 0,",
      "  email: (v) => /^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]{2,}\\$/.test(String(v).trim()),",
      "  telephoneCI: (v) => /^(?:(?:\\\\+|00)225[\\\\s.-]?)?(?:0[157]|2[157])(?:[\\\\s.-]?\\\\d{2}){4}\\$/.test(String(v).trim()),",
      "  telephoneFR: (v) => /^(?:(?:\\\\+|00)33[\\\\s.-]?|0)[1-9](?:[\\\\s.-]?\\\\d{2}){4}\\$/.test(String(v).trim()),",
      "  telephoneInternational: (v) => /^\\\\+[1-9]\\\\d{7,14}\\$/.test(String(v).replace(/[\\\\s.-]/g, \"\")),",
      "  url: (v) => {",
      "    try {",
      "      return [\"http:\", \"https:\"].includes(new URL(v).protocol);",
      "    } catch {",
      "      return false;",
      "    }",
      "  },",
      "  longueurMin: (n) => (v) => String(v ?? \"\").length >= n,",
      "  longueurMax: (n) => (v) => String(v ?? \"\").length <= n,",
      "  identique: (autre) => (v) => v === autre,",
      "};",
      "",
      "// Valide un objet de données : { champ: [[regle, \"message\"], ...] }",
      "// Renvoie { valide, erreurs: { champ: \"premier message en échec\" } }",
      "export function validerFormulaire(donnees, regles) {",
      "  const erreurs = {};",
      "  for (const [champ, liste] of Object.entries(regles)) {",
      "    for (const [regle, message] of liste) {",
      "      if (!regle(donnees[champ] ?? \"\")) {",
      "        erreurs[champ] = message;",
      "        break;",
      "      }",
      "    }",
      "  }",
      "  return { valide: Object.keys(erreurs).length === 0, erreurs };",
      "}"
    ]
  },
  "web/utilitaires/compte-a-rebours": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-rebours",
    "description": "Compte à rebours fiable (« Renvoyer le code dans 00:30 », promos)",
    "body": [
      "// 65000 → \"01:05\" ; 3725000 → \"1:02:05\"",
      "export function formaterDuree(ms) {",
      "  const total = Math.max(0, Math.ceil(ms / 1000));",
      "  const h = Math.floor(total / 3600);",
      "  const m = Math.floor((total % 3600) / 60);",
      "  const s = total % 60;",
      "  const deux = (n) => String(n).padStart(2, \"0\");",
      "  return h ? `\\${h}:\\${deux(m)}:\\${deux(s)}` : `\\${deux(m)}:\\${deux(s)}`;",
      "}",
      "",
      "// Compte à rebours basé sur l'heure réelle : reste juste même si l'onglet dort en arrière-plan.",
      "export function compteARebours(dureeMs, { surTic, surFin, intervalle = 250 } = {}) {",
      "  const fin = Date.now() + dureeMs;",
      "  const reste = () => Math.max(0, fin - Date.now());",
      "  const id = setInterval(tic, intervalle);",
      "  function tic() {",
      "    const r = reste();",
      "    surTic?.(r);",
      "    if (r === 0) {",
      "      clearInterval(id);",
      "      surFin?.();",
      "    }",
      "  }",
      "  tic();",
      "  return { reste, arreter: () => clearInterval(id) };",
      "}"
    ]
  },
  "web/utilitaires/crypto": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-crypto",
    "description": "UUID, code OTP, jeton aléatoire sûrs et empreinte SHA-256",
    "body": [
      "// Aléatoire sûr et empreintes, avec l'API Web Crypto (navigateur et Node 18+).",
      "// Ne jamais utiliser Math.random() pour un code, un jeton ou un identifiant sensible.",
      "",
      "export function identifiantUnique() {",
      "  return crypto.randomUUID();",
      "}",
      "",
      "// Code aléatoire sans biais : codeAleatoire(6) → \"048213\"",
      "export function codeAleatoire(longueur = 6, alphabet = \"0123456789\") {",
      "  const limite = 256 - (256 % alphabet.length); // rejette les octets qui biaiseraient le tirage",
      "  let code = \"\";",
      "  while (code.length < longueur) {",
      "    for (const octet of crypto.getRandomValues(new Uint8Array(longueur * 2))) {",
      "      if (octet < limite) code += alphabet[octet % alphabet.length];",
      "      if (code.length === longueur) break;",
      "    }",
      "  }",
      "  return code;",
      "}",
      "",
      "// Jeton aléatoire encodé en base64url (liens d'invitation, jetons de session…)",
      "export function jetonAleatoire(octets = 32) {",
      "  const binaire = String.fromCharCode(...crypto.getRandomValues(new Uint8Array(octets)));",
      "  return btoa(binaire).replace(/\\\\+/g, \"-\").replace(/\\\\//g, \"_\").replace(/=+\\$/, \"\");",
      "}",
      "",
      "// Empreinte SHA-256 en hexadécimal",
      "export async function sha256(texte) {",
      "  const empreinte = await crypto.subtle.digest(\"SHA-256\", new TextEncoder().encode(texte));",
      "  return [...new Uint8Array(empreinte)].map((o) => o.toString(16).padStart(2, \"0\")).join(\"\");",
      "}"
    ]
  },
  "web/utilitaires/dates": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-dates",
    "description": "Dates relatives (« il y a 3 h ») et formatage en français",
    "body": [
      "const UNITES = [",
      "  [\"year\", 31536000],",
      "  [\"month\", 2592000],",
      "  [\"week\", 604800],",
      "  [\"day\", 86400],",
      "  [\"hour\", 3600],",
      "  [\"minute\", 60],",
      "  [\"second\", 1],",
      "];",
      "",
      "// « il y a 3 heures », « hier », « dans 2 jours »",
      "export function dateRelative(date, { langue = \"fr\", maintenant = new Date() } = {}) {",
      "  const secondes = Math.round((new Date(date) - maintenant) / 1000);",
      "  const rtf = new Intl.RelativeTimeFormat(langue, { numeric: \"auto\" });",
      "  for (const [unite, duree] of UNITES) {",
      "    if (Math.abs(secondes) >= duree || unite === \"second\") {",
      "      return rtf.format(Math.round(secondes / duree), unite);",
      "    }",
      "  }",
      "}",
      "",
      "// « 11 octobre 2026 » (options Intl.DateTimeFormat acceptées)",
      "export function formaterDate(date, { langue = \"fr-FR\", ...options } = {}) {",
      "  const format = Object.keys(options).length ? options : { dateStyle: \"long\" };",
      "  return new Intl.DateTimeFormat(langue, format).format(new Date(date));",
      "}"
    ]
  },
  "web/utilitaires/debounce": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-debounce",
    "description": "Retarde une fonction tant qu'elle est rappelée (recherche, resize…)",
    "body": [
      "// Retarde l'appel de `fn` jusqu'à ce que `delai` ms passent sans nouvel appel.",
      "export function debounce(fn, delai = 300) {",
      "  let minuteur;",
      "  return (...args) => {",
      "    clearTimeout(minuteur);",
      "    minuteur = setTimeout(() => fn(...args), delai);",
      "  };",
      "}"
    ]
  },
  "web/utilitaires/fetch-json": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-fetch",
    "description": "fetch JSON avec timeout et nouvelles tentatives automatiques",
    "body": [
      "// Requête JSON avec délai max et nouvelles tentatives (attente 0,5 s, 1 s, 2 s…).",
      "export async function fetchJson(url, { timeout = 8000, essais = 3, ...options } = {}) {",
      "  for (let essai = 1; essai <= essais; essai++) {",
      "    const controleur = new AbortController();",
      "    const minuteur = setTimeout(() => controleur.abort(), timeout);",
      "    try {",
      "      const reponse = await fetch(url, { ...options, signal: controleur.signal });",
      "      if (!reponse.ok) {",
      "        const erreur = new Error(`HTTP \\${reponse.status}`);",
      "        erreur.status = reponse.status;",
      "        throw erreur;",
      "      }",
      "      return await reponse.json();",
      "    } catch (erreur) {",
      "      const erreurClient = erreur.status >= 400 && erreur.status < 500;",
      "      if (essai === essais || erreurClient) throw erreur;",
      "      await new Promise((r) => setTimeout(r, 500 * 2 ** (essai - 1)));",
      "    } finally {",
      "      clearTimeout(minuteur);",
      "    }",
      "  }",
      "}"
    ]
  },
  "web/utilitaires/jours-ouvres": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "bib-jours-ouvres",
    "description": "Jours fériés CI/FR, Pâques, ajout de jours ouvrés (délais, échéances)",
    "body": [
      "// Jours fériés et jours ouvrés (délais de virement, livraisons, échéances).",
      "// Les dates sont des chaînes \"AAAA-MM-JJ\" en heure locale (pas de piège de fuseau horaire).",
      "",
      "const versTexte = (d) =>",
      "  `\\${d.getFullYear()}-\\${String(d.getMonth() + 1).padStart(2, \"0\")}-\\${String(d.getDate()).padStart(2, \"0\")}`;",
      "const versDate = (texte) => {",
      "  if (texte instanceof Date) return new Date(texte.getFullYear(), texte.getMonth(), texte.getDate());",
      "  const [a, m, j] = String(texte).slice(0, 10).split(\"-\").map(Number);",
      "  return new Date(a, m - 1, j);",
      "};",
      "const decaler = (date, jours) => new Date(date.getFullYear(), date.getMonth(), date.getDate() + jours);",
      "",
      "// Dimanche de Pâques (algorithme de Meeus/Jones/Butcher)",
      "export function datePaques(annee) {",
      "  const a = annee % 19, b = Math.floor(annee / 100), c = annee % 100;",
      "  const d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25);",
      "  const g = Math.floor((b - f + 1) / 3), h = (19 * a + b - d - g + 15) % 30;",
      "  const i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7;",
      "  const m = Math.floor((a + 11 * h + 22 * l) / 451);",
      "  const mois = Math.floor((h + l - 7 * m + 114) / 31);",
      "  const jour = ((h + l - 7 * m + 114) % 31) + 1;",
      "  return versTexte(new Date(annee, mois - 1, jour));",
      "}",
      "",
      "const FIXES = {",
      "  CI: [\"01-01\", \"05-01\", \"08-07\", \"08-15\", \"11-01\", \"11-15\", \"12-25\"],",
      "  FR: [\"01-01\", \"05-01\", \"05-08\", \"07-14\", \"08-15\", \"11-01\", \"11-11\", \"12-25\"],",
      "};",
      "",
      "// Jours fériés d'une année. Pour la Côte d'Ivoire, les fêtes musulmanes (Ramadan, Tabaski,",
      "// Maouloud…) changent chaque année : ajoute-les avec l'option `feriesEnPlus` d'estJourOuvre.",
      "export function joursFeries(annee, pays = \"CI\") {",
      "  if (!FIXES[pays]) throw new Error(`Pays non géré : \\${pays}`);",
      "  const paques = versDate(datePaques(annee));",
      "  const mobiles = [1, 39, 50].map((j) => versTexte(decaler(paques, j))); // lundi de Pâques, Ascension, lundi de Pentecôte",
      "  return [...FIXES[pays].map((md) => `\\${annee}-\\${md}`), ...mobiles].sort();",
      "}",
      "",
      "export function estJourOuvre(date, { pays = \"CI\", feriesEnPlus = [], samediOuvre = false } = {}) {",
      "  const d = versDate(date);",
      "  const jour = d.getDay();",
      "  if (jour === 0 || (jour === 6 && !samediOuvre)) return false;",
      "  const texte = versTexte(d);",
      "  return !joursFeries(d.getFullYear(), pays).includes(texte) && !feriesEnPlus.includes(texte);",
      "}",
      "",
      "// ajouterJoursOuvres(\"2026-12-24\", 1) → \"2026-12-28\" (saute Noël et le week-end)",
      "export function ajouterJoursOuvres(date, nombre, options = {}) {",
      "  let d = versDate(date);",
      "  const pas = nombre < 0 ? -1 : 1;",
      "  for (let restants = Math.abs(nombre); restants > 0; ) {",
      "    d = decaler(d, pas);",
      "    if (estJourOuvre(d, options)) restants--;",
      "  }",
      "  return versTexte(d);",
      "}",
      "",
      "// Nombre de jours ouvrés après `debut`, jusqu'à `fin` incluse",
      "export function joursOuvresEntre(debut, fin, options = {}) {",
      "  let d = versDate(debut);",
      "  const f = versDate(fin);",
      "  let total = 0;",
      "  while (d < f) {",
      "    d = decaler(d, 1);",
      "    if (estJourOuvre(d, options)) total++;",
      "  }",
      "  return total;",
      "}"
    ]
  },
