  "mobile/android/notification-quotidienne": {
    "scope": "kotlin",
    "prefix": "bib-rappel",
    "description": "Notification de rappel quotidienne à heure fixe (WorkManager)",
    "body": [
      "import android.content.Context",
      "import androidx.work.Data",
      "import androidx.work.ExistingPeriodicWorkPolicy",
      "import androidx.work.PeriodicWorkRequest",
      "import androidx.work.WorkManager",
      "import androidx.work.Worker",
      "import androidx.work.WorkerParameters",
      "import java.time.Duration",
      "import java.time.LocalDateTime",
      "import java.util.concurrent.TimeUnit",
      "",
      "/** Tâche exécutée une fois par jour par WorkManager (survit au redémarrage du téléphone). */",
      "class RappelQuotidien(context: Context, parametres: WorkerParameters) : Worker(context, parametres) {",
      "    override fun doWork(): Result {",
      "        Notifications.afficher(",
      "            applicationContext,",
      "            canalId = inputData.getString(\"canal\") ?: \"rappels\",",
      "            id = 1001,",
      "            titre = inputData.getString(\"titre\") ?: \"\",",
      "            texte = inputData.getString(\"texte\") ?: \"\",",
      "            icone = inputData.getInt(\"icone\", android.R.drawable.ic_dialog_info),",
      "        )",
      "        return Result.success()",
      "    }",
      "}",
      "",
      "object RappelsQuotidiens {",
      "    /** Programme un rappel chaque jour vers heure:minute. Rappeler la fonction remplace l'ancien réglage. */",
      "    fun programmer(",
      "        context: Context,",
      "        heure: Int,",
      "        minute: Int = 0,",
      "        titre: String,",
      "        texte: String,",
      "        icone: Int,",
      "        canal: String = \"rappels\",",
      "        nom: String = \"rappel_quotidien\",",
      "    ) {",
      "        val maintenant = LocalDateTime.now()",
      "        var prochain = maintenant.toLocalDate().atTime(heure, minute)",
      "        if (!prochain.isAfter(maintenant)) prochain = prochain.plusDays(1)",
      "",
      "        val donnees = Data.Builder()",
      "            .putString(\"titre\", titre)",
      "            .putString(\"texte\", texte)",
      "            .putString(\"canal\", canal)",
      "            .putInt(\"icone\", icone)",
      "            .build()",
      "",
      "        val requete = PeriodicWorkRequest.Builder(RappelQuotidien::class.java, 1, TimeUnit.DAYS)",
      "            .setInitialDelay(Duration.between(maintenant, prochain).toMillis(), TimeUnit.MILLISECONDS)",
      "            .setInputData(donnees)",
      "            .build()",
      "",
      "        WorkManager.getInstance(context).enqueueUniquePeriodicWork(nom, ExistingPeriodicWorkPolicy.UPDATE, requete)",
      "    }",
      "",
      "    fun annuler(context: Context, nom: String = \"rappel_quotidien\") {",
      "        WorkManager.getInstance(context).cancelUniqueWork(nom)",
      "    }",
      "}"
    ]
  },
  "mobile/android/notifications": {
    "scope": "kotlin",
    "prefix": "bib-notif",
    "description": "Canal + affichage de notification (Android 8 à 15)",
    "body": [
      "import android.Manifest",
      "import android.app.NotificationChannel",
      "import android.app.NotificationManager",
      "import android.app.PendingIntent",
      "import android.content.Context",
      "import android.content.Intent",
      "import android.content.pm.PackageManager",
      "import android.os.Build",
      "import androidx.core.app.NotificationCompat",
      "import androidx.core.app.NotificationManagerCompat",
      "import androidx.core.content.ContextCompat",
      "",
      "object Notifications {",
      "    /** À appeler au démarrage de l'appli (Application.onCreate). Sans canal, rien ne s'affiche sur Android 8+. */",
      "    fun creerCanal(",
      "        context: Context,",
      "        id: String,",
      "        nom: String,",
      "        description: String = \"\",",
      "        importance: Int = NotificationManager.IMPORTANCE_DEFAULT,",
      "    ) {",
      "        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return",
      "        val canal = NotificationChannel(id, nom, importance).apply { this.description = description }",
      "        context.getSystemService(NotificationManager::class.java).createNotificationChannel(canal)",
      "    }",
      "",
      "    /** Affiche une notification ; un appui ouvre `activite`. Renvoie false si la permission manque. */",
      "    fun afficher(",
      "        context: Context,",
      "        canalId: String,",
      "        id: Int,",
      "        titre: String,",
      "        texte: String,",
      "        icone: Int,",
      "        activite: Class<*>? = null,",
      "    ): Boolean {",
      "        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&",
      "            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED",
      "        ) return false",
      "",
      "        val builder = NotificationCompat.Builder(context, canalId)",
      "            .setSmallIcon(icone)",
      "            .setContentTitle(titre)",
      "            .setContentText(texte)",
      "            .setStyle(NotificationCompat.BigTextStyle().bigText(texte))",
      "            .setAutoCancel(true)",
      "",
      "        if (activite != null) {",
      "            val intent = Intent(context, activite).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)",
      "            builder.setContentIntent(",
      "                PendingIntent.getActivity(context, id, intent, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)",
      "            )",
      "        }",
      "        NotificationManagerCompat.from(context).notify(id, builder.build())",
      "        return true",
      "    }",
      "}"
    ]
  },
  "mobile/android/partage": {
    "scope": "kotlin",
    "prefix": "bib-partager",
    "description": "Partager texte/fichier + ouvrir WhatsApp avec message prérempli",
    "body": [
      "import android.content.ActivityNotFoundException",
      "import android.content.Context",
      "import android.content.Intent",
      "import android.net.Uri",
      "import androidx.core.content.FileProvider",
      "import java.io.File",
      "",
      "/** Ouvre la feuille de partage d'Android avec un texte (WhatsApp, SMS, Gmail…). */",
      "fun Context.partagerTexte(texte: String, titre: String = \"Partager\") {",
      "    val envoi = Intent(Intent.ACTION_SEND).apply {",
      "        type = \"text/plain\"",
      "        putExtra(Intent.EXTRA_TEXT, texte)",
      "    }",
      "    startActivity(Intent.createChooser(envoi, titre).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))",
      "}",
      "",
      "/** Partage un fichier de l'appli (image, PDF…) via le FileProvider déclaré dans le manifeste. */",
      "fun Context.partagerFichier(fichier: File, typeMime: String, texte: String? = null, titre: String = \"Partager\") {",
      "    val uri = FileProvider.getUriForFile(this, \"\\$packageName.fichiers\", fichier)",
      "    val envoi = Intent(Intent.ACTION_SEND).apply {",
