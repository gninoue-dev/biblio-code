{
  "game/godot/boutons-deplacables": {
    "scope": "gdscript",
    "prefix": "bib-boutons-mobiles",
    "description": "Boutons tactiles déplaçables par le joueur, positions mémorisées",
    "body": [
      "extends Control",
      "## Rend les boutons tactiles enfants déplaçables (mode édition des contrôles) et mémorise leur position.",
      "",
      "signal disposition_changee",
      "",
      "@export var fichier := \"user://disposition_boutons.cfg\"",
      "",
      "var mode_edition := false",
      "var _deplace: Control = null",
      "var _decalage := Vector2.ZERO",
      "var _defauts := {}",
      "",
      "",
      "func _ready() -> void:",
      "\tfor bouton in boutons():",
      "\t\t_defauts[bouton.name] = bouton.position",
      "\tcharger()",
      "",
      "",
      "func boutons() -> Array[Control]:",
      "\tvar liste: Array[Control] = []",
      "\tfor enfant in get_children():",
      "\t\tif enfant is Control:",
      "\t\t\tliste.append(enfant)",
      "\treturn liste",
      "",
      "",
      "func _input(event: InputEvent) -> void:",
      "\tif not mode_edition:",
      "\t\treturn",
      "\tvar appui: bool = event is InputEventScreenTouch or (event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT)",
      "\tif appui and event.pressed:",
      "\t\tfor bouton in boutons():",
      "\t\t\tif bouton.get_global_rect().has_point(event.position):",
      "\t\t\t\t_deplace = bouton",
      "\t\t\t\t_decalage = bouton.global_position - event.position",
      "\t\t\t\tget_viewport().set_input_as_handled()",
      "\t\t\t\treturn",
      "\telif appui and not event.pressed and _deplace:",
      "\t\t_deplace = null",
      "\t\tsauvegarder()",
      "\t\tdisposition_changee.emit()",
      "\t\tget_viewport().set_input_as_handled()",
      "\telif _deplace and (event is InputEventScreenDrag or event is InputEventMouseMotion):",
      "\t\tvar ecran := get_viewport_rect().size",
      "\t\tvar limite := (ecran - _deplace.size * _deplace.scale).max(Vector2.ZERO)",
      "\t\t_deplace.global_position = (event.position + _decalage).clamp(Vector2.ZERO, limite)",
      "\t\tget_viewport().set_input_as_handled()",
      "",
      "",
      "func sauvegarder() -> void:",
      "\tvar config := ConfigFile.new()",
      "\tfor bouton in boutons():",
      "\t\tconfig.set_value(\"positions\", bouton.name, bouton.position)",
      "\tconfig.save(fichier)",
      "",
      "",
      "func charger() -> void:",
      "\tvar config := ConfigFile.new()",
      "\tif config.load(fichier) != OK:",
      "\t\treturn",
      "\tfor bouton in boutons():",
      "\t\tif config.has_section_key(\"positions\", bouton.name):",
      "\t\t\tbouton.position = config.get_value(\"positions\", bouton.name)",
      "",
      "",
      "func reinitialiser() -> void:",
      "\tfor bouton in boutons():",
      "\t\tif _defauts.has(bouton.name):",
      "\t\t\tbouton.position = _defauts[bouton.name]",
      "\tsauvegarder()",
      "\tdisposition_changee.emit()"
    ]
  },
  "game/godot/dialogues": {
    "scope": "gdscript",
    "prefix": "bib-dialogue",
    "description": "Boîte de dialogue lettre par lettre, répliques en JSON (mode histoire)",
    "body": [
      "extends Control",
      "## Boîte de dialogue (mode histoire, tutoriel, PNJ) : le texte s'écrit lettre par lettre.",
      "## Un appui affiche tout le texte, l'appui suivant passe à la réplique suivante.",
      "## Enfants attendus : un Label « Nom » et un RichTextLabel « Texte ».",
      "",
      "signal replique_affichee(index: int)",
      "signal termine",
      "",
      "@export var vitesse := 45.0  # caractères par seconde",
      "",
      "var _repliques: Array = []",
      "var _index := 0",
      "var _ecrit := 0.0",
      "",
      "@onready var _nom: Label = \\$Nom",
      "@onready var _texte: RichTextLabel = \\$Texte",
      "",
      "",
      "## repliques : [{ \"nom\": \"Nash\", \"texte\": \"On est où là ?\" }, ...]",
      "func lancer(repliques: Array) -> void:",
      "\t_repliques = repliques",
      "\t_index = 0",
      "\tshow()",
      "\t_afficher()",
      "",
      "",
      "## Lit une liste de répliques dans un fichier JSON : { \"intro\": [ {...}, ... ], \"fin\": [...] }",
      "static func charger(chemin: String, cle: String) -> Array:",
      "\tvar contenu = JSON.parse_string(FileAccess.get_file_as_string(chemin))",
      "\tif contenu is Dictionary and contenu.get(cle) is Array:",
      "\t\treturn contenu[cle]",
      "\tpush_error(\"Dialogue « %s » introuvable dans %s\" % [cle, chemin])",
      "\treturn []",
      "",
      "",
      "func en_train_d_ecrire() -> bool:",
      "\t# -1 signifie « tout le texte est visible »",
      "\treturn _texte.visible_characters != -1 and _texte.visible_characters < _texte.get_total_character_count()",
      "",
      "",
      "func avancer() -> void:",
      "\tif _repliques.is_empty():",
      "\t\treturn",
      "\tif en_train_d_ecrire():",
      "\t\t_texte.visible_characters = -1  # tout afficher d'un coup",
      "\t\treturn",
      "\t_index += 1",
      "\tif _index >= _repliques.size():",
      "\t\t_repliques = []",
      "\t\thide()",
      "\t\ttermine.emit()",
      "\telse:",
      "\t\t_afficher()",
      "",
      "",
      "func _afficher() -> void:",
      "\tvar replique: Dictionary = _repliques[_index]",
      "\t_nom.text = replique.get(\"nom\", \"\")",
      "\t_texte.text = replique.get(\"texte\", \"\")",
      "\t_texte.visible_characters = 0",
      "\t_ecrit = 0.0",
      "\treplique_affichee.emit(_index)",
      "",
      "",
      "func _process(delta: float) -> void:",
      "\tif visible and not _repliques.is_empty() and en_train_d_ecrire():",
      "\t\t_ecrit += delta * vitesse",
      "\t\t_texte.visible_characters = int(_ecrit)",
      "",
      "",
      "func _gui_input(event: InputEvent) -> void:",
      "\tif (event is InputEventMouseButton or event is InputEventScreenTouch) and event.pressed:",
      "\t\tavancer()",
      "\t\taccept_event()",
      "",
      "",
      "func _unhandled_input(event: InputEvent) -> void:",
      "\tif visible and event.is_action_pressed(\"ui_accept\"):",
      "\t\tavancer()",
      "\t\tget_viewport().set_input_as_handled()"
    ]
  },
  "game/godot/economie": {
    "scope": "gdscript",
    "prefix": "bib-economie",
    "description": "Monnaies du jeu + objets possédés (skins) pour un jeu free-to-play",
    "body": [
      "class_name Economie",
      "extends RefCounted",
      "## Portefeuille du joueur (pièces, gemmes…) et objets possédés (skins, personnages).",
      "## Impossible d'avoir un solde négatif ou d'acheter deux fois le même objet.",
      "",
      "signal solde_change(monnaie: StringName, solde: int)",
      "signal objet_obtenu(id: StringName)",
      "",
      "var _soldes := {}",
      "var _possedes := {}",
      "",
      "",
      "func solde(monnaie: StringName) -> int:",
      "\treturn int(_soldes.get(monnaie, 0))",
      "",
      "",
      "func crediter(monnaie: StringName, montant: int) -> void:",
      "\tif montant <= 0:",
      "\t\treturn",
      "\t_soldes[monnaie] = solde(monnaie) + montant",
      "\tsolde_change.emit(monnaie, solde(monnaie))",
      "",
      "",
      "func peut_payer(monnaie: StringName, prix: int) -> bool:",
      "\treturn prix >= 0 and solde(monnaie) >= prix",
      "",
      "",
      "func debiter(monnaie: StringName, prix: int) -> bool:",
      "\tif not peut_payer(monnaie, prix):",
      "\t\treturn false",
      "\t_soldes[monnaie] = solde(monnaie) - prix",
      "\tsolde_change.emit(monnaie, solde(monnaie))",
      "\treturn true",
      "",
      "",
      "func possede(id: StringName) -> bool:",
      "\treturn _possedes.has(id)",
      "",
      "",
      "## Achat avec la monnaie du jeu. Renvoie false si déjà possédé ou pas assez d'argent.",
      "func acheter(id: StringName, monnaie: StringName, prix: int) -> bool:",
      "\tif possede(id) or not debiter(monnaie, prix):",
      "\t\treturn false",
      "\tdonner(id)",
      "\treturn true",
      "",
      "",
      "## Objet offert (récompense, achat réel validé par le magasin)",
      "func donner(id: StringName) -> void:",
      "\tif possede(id):",
      "\t\treturn",
      "\t_possedes[id] = true",
      "\tobjet_obtenu.emit(id)",
      "",
      "",
      "func vers_dictionnaire() -> Dictionary:",
      "\treturn {\"soldes\": _soldes.duplicate(), \"possedes\": _possedes.keys().map(func(k): return String(k))}",
      "",
      "",
      "func depuis_dictionnaire(d: Dictionary) -> void:",
      "\t_soldes.clear()",
      "\tfor monnaie in d.get(\"soldes\", {}):",
      "\t\t_soldes[StringName(monnaie)] = int(d[\"soldes\"][monnaie])",
      "\t_possedes.clear()",
      "\tfor id in d.get(\"possedes\", []):",
      "\t\t_possedes[StringName(id)] = true"
    ]
  },
  "game/godot/gestionnaire-audio": {
    "scope": "gdscript",
    "prefix": "bib-audio",
    "description": "Audio : musique en fondu enchaîné, effets superposés, volumes sauvegardés",
    "body": [
      "extends Node",
      "## Autoload : musique avec fondu enchaîné, effets sonores qui se superposent, volumes sauvegardés.",
      "## Crée les bus « Musique » et « Effets » dans l'onglet Audio (sinon tout passe par Master).",
      "",
      "const FICHIER := \"user://audio.cfg\"",
      "const SILENCE_DB := -40.0",
      "",
      "var _musiques: Array[AudioStreamPlayer] = []",
      "var _active := 0",
      "var _effets: Array[AudioStreamPlayer] = []",
      "var _prochain_effet := 0",
      "",
      "",
      "func _ready() -> void:",
      "\tprocess_mode = Node.PROCESS_MODE_ALWAYS",
      "\tfor i in 2:",
      "\t\t_musiques.append(_lecteur(&\"Musique\"))",
      "\tfor i in 8:",
      "\t\t_effets.append(_lecteur(&\"Effets\"))",
      "\tcharger_volumes()",
      "",
      "",
      "func _lecteur(bus: StringName) -> AudioStreamPlayer:",
      "\tvar lecteur := AudioStreamPlayer.new()",
      "\tlecteur.bus = bus if AudioServer.get_bus_index(bus) != -1 else &\"Master\"",
      "\tadd_child(lecteur)",
      "\treturn lecteur",
      "",
      "",
      "func jouer_musique(flux: AudioStream, fondu := 1.0) -> void:",
      "\tvar ancienne := _musiques[_active]",
      "\tif ancienne.stream == flux and ancienne.playing:",
      "\t\treturn",
      "\t_active = 1 - _active",
      "\tvar nouvelle := _musiques[_active]",
      "\tnouvelle.stream = flux",
      "\tnouvelle.volume_db = SILENCE_DB",
      "\tnouvelle.play()",
      "\tvar tween := create_tween().set_parallel()",
      "\ttween.tween_property(nouvelle, \"volume_db\", 0.0, fondu)",
      "\ttween.tween_property(ancienne, \"volume_db\", SILENCE_DB, fondu)",
      "\ttween.chain().tween_callback(ancienne.stop)",
      "",
      "",
      "func arreter_musique(fondu := 1.0) -> void:",
      "\tvar lecteur := _musiques[_active]",
      "\tvar tween := create_tween()",
      "\ttween.tween_property(lecteur, \"volume_db\", SILENCE_DB, fondu)",
      "\ttween.tween_callback(lecteur.stop)",
      "",
      "",
      "## variation : légère différence de hauteur à chaque lecture (évite l'effet « mitraillette »)",
      "func jouer_effet(flux: AudioStream, variation := 0.05, volume_db := 0.0) -> void:",
      "\tvar lecteur: AudioStreamPlayer = null",
      "\tfor l in _effets:",
      "\t\tif not l.playing:",
      "\t\t\tlecteur = l",
      "\t\t\tbreak",
      "\tif lecteur == null:  # tous occupés : on coupe le plus ancien",
      "\t\tlecteur = _effets[_prochain_effet]",
      "\t\t_prochain_effet = (_prochain_effet + 1) % _effets.size()",
      "\tlecteur.stream = flux",
      "\tlecteur.pitch_scale = 1.0 + randf_range(-variation, variation)",
      "\tlecteur.volume_db = volume_db",
      "\tlecteur.play()",
      "",
      "",
      "## volume entre 0 et 1 (pour un curseur)",
      "func regler_volume(bus: StringName, volume: float, sauvegarder := true) -> void:",
      "\tvar index := AudioServer.get_bus_index(bus)",
      "\tif index == -1:",
      "\t\treturn",
      "\tvolume = clampf(volume, 0.0, 1.0)",
      "\tAudioServer.set_bus_volume_db(index, linear_to_db(maxf(volume, 0.0001)))",
      "\tAudioServer.set_bus_mute(index, volume <= 0.0001)",
      "\tif sauvegarder:",
      "\t\tvar config := ConfigFile.new()",
      "\t\tconfig.load(FICHIER)",
      "\t\tconfig.set_value(\"volumes\", bus, volume)",
      "\t\tconfig.save(FICHIER)",
      "",
      "",
      "func volume(bus: StringName) -> float:",
      "\tvar index := AudioServer.get_bus_index(bus)",
      "\tif index == -1 or AudioServer.is_bus_mute(index):",
      "\t\treturn 0.0",
      "\treturn db_to_linear(AudioServer.get_bus_volume_db(index))",
      "",
      "",
      "func charger_volumes() -> void:",
      "\tvar config := ConfigFile.new()",
      "\tif config.load(FICHIER) != OK:",
      "\t\treturn",
      "\tfor bus in config.get_section_keys(\"volumes\"):",
      "\t\tregler_volume(bus, config.get_value(\"volumes\", bus), false)"
    ]
  },
  "game/godot/hitstop": {
    "scope": "gdscript",
    "prefix": "bib-hitstop",
    "description": "Gel d'impact (hitstop) + vibration, pour des coups qui ont du poids",
    "body": [
      "extends Node",
      "## Autoload : gel bref du jeu sur un impact (« hitstop ») + vibration du téléphone.",
      "",
      "var _jeton := 0",
      "",
      "",
      "func geler(duree := 0.08, echelle := 0.0, vibration_ms := 0) -> void:",
      "\t_jeton += 1",
      "\tvar mien := _jeton",
      "\tEngine.time_scale = echelle",
      "\tif vibration_ms > 0 and OS.has_feature(\"mobile\"):",
      "\t\tInput.vibrate_handheld(vibration_ms)",
      "\t# ignore_time_scale = true : le minuteur avance en temps réel même si le jeu est figé",
      "\tawait get_tree().create_timer(duree, true, false, true).timeout",
      "\tif mien == _jeton:  # un gel plus récent a pu prendre le relais",
      "\t\tEngine.time_scale = 1.0"
    ]
  },
  "game/godot/joystick-tactile": {
    "scope": "gdscript",
    "prefix": "bib-joystick",
    "description": "Joystick virtuel tactile multi-touch (Godot 4)",
    "body": [
      "extends Control",
      "## Joystick virtuel tactile. Lire `direction` (Vector2, longueur 0 à 1) depuis le joueur.",
      "",
      "@export var rayon := 80.0",
      "@export var zone_morte := 0.15",
      "",
      "var direction := Vector2.ZERO",
      "var _doigt := -1",
      "var _position_bouton := Vector2.ZERO",
      "",
      "",
      "func _input(event: InputEvent) -> void:",
      "\tif event is InputEventScreenTouch:",
      "\t\tif event.pressed and _doigt == -1 and get_global_rect().has_point(event.position):",
      "\t\t\t_doigt = event.index",
      "\t\t\t_mettre_a_jour(event.position)",
      "\t\telif not event.pressed and event.index == _doigt:",
      "\t\t\t_doigt = -1",
      "\t\t\tdirection = Vector2.ZERO",
      "\t\t\t_position_bouton = Vector2.ZERO",
      "\t\t\tqueue_redraw()",
      "\telif event is InputEventScreenDrag and event.index == _doigt:",
      "\t\t_mettre_a_jour(event.position)",
      "",
      "",
      "func _mettre_a_jour(position_ecran: Vector2) -> void:",
      "\tvar ecart := (position_ecran - get_global_rect().get_center()).limit_length(rayon)",
      "\t_position_bouton = ecart",
      "\tvar d := ecart / rayon",
      "\tdirection = d if d.length() > zone_morte else Vector2.ZERO",
      "\tqueue_redraw()",
      "",
      "",
      "func _draw() -> void:",
      "\tvar centre := size / 2",
      "\tdraw_circle(centre, rayon, Color(1, 1, 1, 0.15))",
      "\tdraw_circle(centre + _position_bouton, rayon * 0.4, Color(1, 1, 1, 0.5))"
    ]
  },
  "game/godot/machine-etats": {
    "scope": "gdscript",
    "prefix": "bib-etats",
    "description": "Machine à états (joueur, ennemi, IA, menus) par fonctions",
    "body": [
      "class_name MachineEtats",
      "extends RefCounted",
      "## Machine à états simple : chaque état a des fonctions entrer / mettre à jour / sortir.",
      "",
      "signal etat_change(ancien: StringName, nouveau: StringName)",
      "",
      "var etat: StringName = &\"\"",
      "var etat_precedent: StringName = &\"\"",
      "var temps_dans_etat := 0.0",
      "var _etats := {}",
      "",
      "",
      "func ajouter(nom: StringName, entrer := Callable(), mettre_a_jour := Callable(), sortir := Callable()) -> MachineEtats:",
      "\t_etats[nom] = {\"entrer\": entrer, \"maj\": mettre_a_jour, \"sortir\": sortir}",
      "\treturn self",
      "",
      "",
      "func changer(nouveau: StringName) -> void:",
      "\tassert(_etats.has(nouveau), \"État inconnu : %s\" % nouveau)",
      "\tif nouveau == etat:",
      "\t\treturn",
      "\tif _etats.has(etat) and _etats[etat][\"sortir\"].is_valid():",
      "\t\t_etats[etat][\"sortir\"].call()",
      "\tetat_precedent = etat",
      "\tetat = nouveau",
      "\ttemps_dans_etat = 0.0",
      "\tif _etats[nouveau][\"entrer\"].is_valid():",
      "\t\t_etats[nouveau][\"entrer\"].call()",
      "\tetat_change.emit(etat_precedent, etat)",
      "",
      "",
      "func mettre_a_jour(delta: float) -> void:",
      "\ttemps_dans_etat += delta",
      "\tif _etats.has(etat) and _etats[etat][\"maj\"].is_valid():",
      "\t\t_etats[etat][\"maj\"].call(delta)",
      "",
      "",
      "func est(nom: StringName) -> bool:",
      "\treturn etat == nom"
    ]
  },
  "game/godot/recompense-quotidienne": {
    "scope": "gdscript",
    "prefix": "bib-quotidien",
    "description": "Récompense de connexion quotidienne avec série (rétention F2P)",
    "body": [
      "class_name RecompenseQuotidienne",
      "extends RefCounted",
      "## Récompense de connexion quotidienne avec série (jours consécutifs). Un jour manqué = retour au jour 1.",
      "",
      "var recompenses: Array = [50, 75, 100, 150, 200, 300, 500]  # jour 1 à 7, puis on recommence",
      "var dernier_jour := -1  # numéro du dernier jour réclamé",
      "var serie := 0",
      "",
      "",
      "## Numéro du jour calendaire LOCAL (change à minuit chez le joueur)",
      "static func jour_actuel() -> int:",
      "\tvar maintenant := Time.get_datetime_dict_from_system()",
      "\treturn int(Time.get_unix_time_from_datetime_dict(maintenant) / 86400)",
      "",
      "",
      "func disponible(jour: int = jour_actuel()) -> bool:",
      "\treturn jour > dernier_jour",
      "",
      "",
      "func serie_si_reclamee(jour: int = jour_actuel()) -> int:",
      "\treturn serie + 1 if jour == dernier_jour + 1 else 1",
      "",
      "",
      "func prochaine_recompense(jour: int = jour_actuel()) -> int:",
      "\treturn recompenses[(serie_si_reclamee(jour) - 1) % recompenses.size()]",
      "",
      "",
      "## Renvoie la récompense gagnée (0 si déjà réclamée aujourd'hui).",
      "func reclamer(jour: int = jour_actuel()) -> int:",
      "\tif not disponible(jour):",
      "\t\treturn 0",
      "\tvar gain: int = prochaine_recompense(jour)",
      "\tserie = serie_si_reclamee(jour)",
      "\tdernier_jour = jour",
      "\treturn gain",
      "",
      "",
      "func vers_dictionnaire() -> Dictionary:",
      "\treturn {\"dernier_jour\": dernier_jour, \"serie\": serie}",
      "",
      "",
      "func depuis_dictionnaire(d: Dictionary) -> void:",
      "\tdernier_jour = int(d.get(\"dernier_jour\", -1))",
      "\tserie = int(d.get(\"serie\", 0))"
    ]
  },
  "game/godot/sauvegarde": {
    "scope": "gdscript",
    "prefix": "bib-save-godot",
    "description": "Autoload de sauvegarde JSON dans user:// (Godot 4)",
    "body": [
      "extends Node",
      "## Autoload : sauvegarde/chargement de la progression en JSON dans user://",
      "",
      "const CHEMIN := \"user://sauvegarde.json\"",
      "",
      "var donnees: Dictionary = {}",
      "",
      "",
      "func _ready() -> void:",
      "\tcharger()",
      "",
      "",
      "func sauvegarder() -> void:",
      "\tvar fichier := FileAccess.open(CHEMIN, FileAccess.WRITE)",
      "\tif fichier == null:",
      "\t\tpush_error(\"Sauvegarde impossible : %s\" % error_string(FileAccess.get_open_error()))",
      "\t\treturn",
      "\tfichier.store_string(JSON.stringify(donnees, \"\\\\t\"))",
      "",
      "",
      "func charger() -> void:",
      "\tif not FileAccess.file_exists(CHEMIN):",
      "\t\treturn",
      "\tvar resultat = JSON.parse_string(FileAccess.get_file_as_string(CHEMIN))",
      "\tif resultat is Dictionary:",
      "\t\tdonnees = resultat",
      "\telse:",
      "\t\tpush_warning(\"Sauvegarde illisible, ignorée.\")"
    ]
  },
  "game/godot/sauvegarde-versionnee": {
    "scope": "gdscript",
    "prefix": "bib-save-version",
    "description": "Sauvegarde versionnée : migrations, écriture sûre, copie de secours",
    "body": [
      "extends Node",
      "## Autoload : sauvegarde JSON avec numéro de version, migrations automatiques,",
      "## écriture sûre (fichier temporaire) et copie de secours (.bak) en cas de fichier abîmé.",
      "",
      "const VERSION := 3",
      "",
      "var chemin := \"user://sauvegarde.json\"",
      "var donnees: Dictionary = {}",
      "",
      "",
      "func _ready() -> void:",
      "\tcharger()",
      "",
      "",
      "## Valeurs d'une partie neuve. Ajoute ici chaque nouveau champ.",
      "func _defaut() -> Dictionary:",
      "\treturn {\"version\": VERSION, \"pieces\": 0, \"skins\": [], \"options\": {\"vibrations\": true}}",
      "",
      "",
      "## Une fonction par changement de format : _migrer_1_vers_2, _migrer_2_vers_3…",
      "## Ne supprime jamais une migration : un joueur peut sauter plusieurs mises à jour.",
      "func _migrer_1_vers_2(d: Dictionary) -> void:",
      "\td[\"skins\"] = d.get(\"skins_debloques\", [])",
      "\td.erase(\"skins_debloques\")",
      "",
      "",
      "func _migrer_2_vers_3(d: Dictionary) -> void:",
      "\td[\"options\"] = {\"vibrations\": d.get(\"vibrations\", true)}",
      "\td.erase(\"vibrations\")",
      "",
      "",
      "func charger() -> void:",
      "\tdonnees = _lire(chemin)",
      "\tif donnees.is_empty():",
      "\t\tdonnees = _lire(chemin + \".bak\")",
      "\tif donnees.is_empty():",
      "\t\tdonnees = _defaut()",
      "\t\treturn",
      "\tvar version := int(donnees.get(\"version\", 1))",
      "\twhile version < VERSION:",
      "\t\tvar methode := \"_migrer_%d_vers_%d\" % [version, version + 1]",
      "\t\tif has_method(methode):",
      "\t\t\tcall(methode, donnees)",
      "\t\tversion += 1",
      "\tdonnees[\"version\"] = VERSION",
      "\tvar defaut := _defaut()",
      "\tfor cle in defaut:",
      "\t\tif not donnees.has(cle):",
      "\t\t\tdonnees[cle] = defaut[cle]",
      "",
      "",
      "func sauvegarder() -> bool:",
      "\tvar temporaire := chemin + \".tmp\"",
      "\tvar fichier := FileAccess.open(temporaire, FileAccess.WRITE)",
      "\tif fichier == null:",
      "\t\tpush_error(\"Sauvegarde impossible : %s\" % error_string(FileAccess.get_open_error()))",
      "\t\treturn false",
      "\tfichier.store_string(JSON.stringify(donnees))",
      "\tfichier.close()",
      "\tif FileAccess.file_exists(chemin):",
      "\t\tif FileAccess.file_exists(chemin + \".bak\"):",
      "\t\t\tDirAccess.remove_absolute(chemin + \".bak\")",
      "\t\tDirAccess.rename_absolute(chemin, chemin + \".bak\")",
      "\treturn DirAccess.rename_absolute(temporaire, chemin) == OK",
      "",
      "",
      "func effacer() -> void:",
      "\tfor suffixe in [\"\", \".bak\", \".tmp\"]:",
      "\t\tif FileAccess.file_exists(chemin + suffixe):",
      "\t\t\tDirAccess.remove_absolute(chemin + suffixe)",
      "\tdonnees = _defaut()",
      "",
      "",
      "func _lire(fichier: String) -> Dictionary:",
      "\tif not FileAccess.file_exists(fichier):",
      "\t\treturn {}",
      "\tvar json := JSON.new()  # JSON.new().parse() : pas d'erreur affichée si le fichier est abîmé",
      "\tif json.parse(FileAccess.get_file_as_string(fichier)) != OK:",
      "\t\treturn {}",
      "\treturn json.data if json.data is Dictionary else {}"
    ]
  },
  "game/godot/tampon-entrees": {
    "scope": "gdscript",
    "prefix": "bib-tampon",
    "description": "Tampon d'entrées (input buffer) pour des commandes réactives",
    "body": [
      "class_name TamponEntrees",
      "extends RefCounted",
      "## Garde un appui en mémoire quelques instants : une action pressée un peu trop tôt n'est pas perdue.",
      "## Indispensable dans un jeu d'action ou de combat pour des commandes « réactives ».",
      "",
      "var duree := 0.15",
      "var _appuis := {}  # action -> temps restant",
      "",
      "",
      "func enregistrer(action: StringName) -> void:",
      "\t_appuis[action] = duree",
      "",
      "",
      "func mettre_a_jour(delta: float) -> void:",
      "\tfor action in _appuis.keys():",
      "\t\t_appuis[action] -= delta",
      "\t\tif _appuis[action] <= 0.0:",
      "\t\t\t_appuis.erase(action)",
      "",
      "",
      "## Vrai si l'action a été pressée récemment ; l'appui est alors consommé.",
      "func consommer(action: StringName) -> bool:",
      "\tif _appuis.has(action):",
      "\t\t_appuis.erase(action)",
      "\t\treturn true",
      "\treturn false",
      "",
      "",
      "func contient(action: StringName) -> bool:",
      "\treturn _appuis.has(action)",
      "",
      "",
      "func vider() -> void:",
      "\t_appuis.clear()"
    ]
  },
